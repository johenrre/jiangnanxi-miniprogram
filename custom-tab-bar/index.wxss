.tab-bar {
  position: fixed;
  z-index: 9000;
  right: 20rpx;
  bottom: calc(13rpx + env(safe-area-inset-bottom));
  left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 108rpx;
  padding: 8rpx 10rpx;
  overflow: visible;
  border: 1rpx solid var(--color-border-hairline);
  border-radius: 32rpx;
  background: var(--color-nav-surface);
  box-shadow:
    0 16rpx 42rpx var(--color-nav-shadow),
    0 2rpx 8rpx var(--color-nav-shadow-soft);
  box-sizing: border-box;
  opacity: 1;
  transform: translate3d(0, 0, 0);
  transition:
    opacity 180ms ease,
    transform 260ms cubic-bezier(0.22, 0.72, 0.24, 1);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  will-change: transform;
}

.tab-bar--hidden {
  opacity: 0;
  transform: translate3d(0, 160%, 0);
  pointer-events: none;
}

.tab-bar__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 88rpx;
  padding: 0;
  flex: 1 1 0;
  flex-direction: column;
  border: 0;
  background: transparent;
  color: #999999;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1;
  transition: opacity 100ms ease, transform 120ms ease;
}

.tab-bar__item--pressed {
  opacity: 0.62;
  transform: scale(0.96);
}

.tab-bar__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  flex: 0 0 48rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.tab-bar__icon {
  display: block;
  width: 48rpx;
  height: 48rpx;
  filter: none;
}

.tab-bar__label {
  display: block;
  max-width: 120rpx;
  margin-top: 6rpx;
  color: #999999;
  font-family: var(--font-body);
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tab-bar__item--active .tab-bar__label {
  color: #b50102;
  font-weight: 400;
}

.tab-bar__active-dot {
  display: none;
}

.tab-bar__item--primary {
  z-index: auto;
  height: 88rpx;
  padding: 0;
  transform: none;
}

.tab-bar__item--primary.tab-bar__item--pressed {
  opacity: 0.62;
  transform: scale(0.96);
}

.tab-bar__item--primary .tab-bar__icon-shell {
  width: 48rpx;
  height: 48rpx;
  flex-basis: 48rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.tab-bar__item--primary .tab-bar__icon {
  width: 48rpx;
  height: 48rpx;
  filter: none;
}

.tab-bar__item--primary .tab-bar__label {
  color: #999999;
  font-size: 22rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.tab-bar__item--primary.tab-bar__item--active .tab-bar__label {
  color: #b50102;
}

@media (prefers-reduced-motion: reduce) {
  .tab-bar,
  .tab-bar__item {
    transition: none;
  }
}
