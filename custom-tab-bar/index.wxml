<view class="theme-root {{themeClass}} tab-bar {{hidden ? 'tab-bar--hidden' : ''}}">
  <view
    wx:for="{{tabs}}"
    wx:key="pagePath"
    class="tab-bar__item {{selected === index ? 'tab-bar__item--active' : ''}} {{item.isPrimary ? 'tab-bar__item--primary' : ''}}"
    data-index="{{index}}"
    bindtap="handleTabSelect"
    hover-class="tab-bar__item--pressed"
    hover-stay-time="80"
    role="button"
    aria-label="{{item.text}}"
  >
    <view class="tab-bar__icon-shell">
      <image
        class="tab-bar__icon"
        src="{{selected === index ? item.selectedIconPath : item.iconPath}}"
        mode="aspectFit"
      />
    </view>
    <text class="tab-bar__label">{{item.text}}</text>
    <view
      wx:if="{{selected === index && !item.isPrimary}}"
      class="tab-bar__active-dot"
    ></view>
  </view>
</view>
