:host {
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}

.material-picker {
  display: flex;
  width: 100%;
  height: 100%;
  min-height: 0;
  flex-direction: column;
}

.main-category-tabs,
.material-panel {
  position: relative;
  z-index: 5;
  box-sizing: border-box;
  width: 100%;
}

.main-category-tabs__track,
.material-card__meta,
.size-switch {
  display: flex;
  align-items: center;
}

.main-category-tabs {
  height: 72rpx;
  min-height: 72rpx;
  border-top: 1rpx solid rgba(83, 101, 95, 0.06);
  border-bottom: 1rpx solid var(--color-divider);
  background: var(--color-bg-section);
  white-space: nowrap;
}

.main-category-tabs__track {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  padding: 0 22rpx;
}

.main-category {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 70rpx;
  margin: 0;
  padding: 0;
  flex: 1;
  color: #8a928f;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: color 120ms ease;
}

.main-category::after,
.subcategory::after,
.size-switch__button::after,
.material-error__retry::after {
  display: none;
}

.main-category--active {
  color: var(--color-primary);
  font-weight: 700;
}

.main-category__indicator {
  position: absolute;
  right: 50%;
  bottom: 0;
  width: 34rpx;
  height: 4rpx;
  border-radius: 2rpx 2rpx 0 0;
  background: var(--color-accent-blush);
  transform: translateX(50%);
  pointer-events: none;
}

.material-panel {
  display: flex;
  min-height: 0;
  flex: 1;
  background: var(--color-bg-page);
}

.subcategory-list {
  width: 140rpx;
  height: 100%;
  flex: 0 0 140rpx;
  border-right: 1rpx solid var(--color-divider);
  background: #f1efe9;
}

.subcategory-list__inner {
  padding: 12rpx 0 calc(150rpx + env(safe-area-inset-bottom));
}

.subcategory {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 82rpx;
  margin: 0;
  padding: 12rpx 14rpx 12rpx 28rpx;
  overflow: hidden;
  color: #858d89;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  text-align: left;
}

.subcategory--active {
  background: var(--color-surface-glass-strong);
  color: #536e67;
  font-weight: 700;
}

.subcategory--active::before {
  position: absolute;
  top: 20rpx;
  bottom: 20rpx;
  left: 0;
  width: 4rpx;
  border-radius: 0 3rpx 3rpx 0;
  background: var(--color-primary-light);
  content: "";
}

.material-grid-scroll {
  min-width: 0;
  height: 100%;
  flex: 1;
}

.material-grid {
  display: grid;
  padding: 14rpx 22rpx calc(150rpx + env(safe-area-inset-bottom)) 14rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.material-card {
  position: relative;
  box-sizing: border-box;
  height: 240rpx;
  min-width: 0;
  padding: 8rpx 8rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--color-divider);
  border-radius: 18rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 7rpx 18rpx var(--color-shadow-soft);
  transition: transform 90ms ease, opacity 90ms ease;
}

.material-card--pressed {
  opacity: 0.76;
  transform: scale(0.98);
}

.material-card__usage {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 18rpx;
  background: rgba(61, 105, 93, 0.9);
  box-shadow: 0 4rpx 10rpx rgba(44, 75, 67, 0.2);
  color: #fff;
  font-size: 17rpx;
  font-weight: 700;
  line-height: 1;
  pointer-events: none;
}

.material-card__media {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 128rpx;
  overflow: hidden;
  border-radius: 14rpx;
  background:
    radial-gradient(circle at 50% 48%, rgba(255, 255, 255, 0.94) 0 34%, rgba(229, 235, 231, 0.58) 72%, rgba(224, 230, 226, 0.34) 100%);
}

.material-card__image {
  width: 92rpx;
  height: 92rpx;
}

.material-card__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 78rpx;
  height: 78rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, var(--color-white), #b9cdc8 62%, #607d78);
  color: #5f6d5f;
  font-size: 26rpx;
  font-weight: 800;
}

.material-card__details {
  display: flex;
  align-items: center;
  min-width: 0;
  flex-direction: column;
}

.material-card--plain.material-card--single-size .material-card__details {
  padding-top: 12rpx;
}

.material-card__name {
  display: block;
  width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: 19rpx;
  font-weight: 700;
  line-height: 26rpx;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-card__fit {
  display: block;
  max-width: 100%;
  height: 21rpx;
  margin-top: 1rpx;
  padding: 0 4rpx;
  overflow: hidden;
  color: #a88379;
  font-size: 14rpx;
  font-weight: 600;
  line-height: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.material-card__meta {
  margin-top: 3rpx;
  justify-content: center;
  color: var(--color-text-secondary);
  font-size: 18rpx;
  font-weight: 550;
  gap: 4rpx;
  line-height: 25rpx;
}

.material-card__price {
  color: var(--color-primary-pressed);
  font-weight: 700;
}

.material-card__separator {
  color: #b1b6b3;
}

.size-switch {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  height: 44rpx;
  margin: 0;
  border-top: 1rpx solid var(--color-divider);
  background: #f7f5f0;
}

.size-switch__button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50%;
  min-width: 0;
  height: 44rpx;
  margin: 0;
  padding: 0;
  flex: 1;
  color: var(--color-primary);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1;
}

.size-switch__button--disabled {
  color: #bcc5c1;
}

.size-switch__divider {
  width: 1rpx;
  height: 20rpx;
  flex: 0 0 1rpx;
  background: var(--color-border-hairline);
}

.material-grid__more {
  display: block;
  padding: 18rpx 0 4rpx;
  color: var(--color-primary-light);
  font-size: 18rpx;
  text-align: center;
  grid-column: 1 / -1;
}

.material-state {
  display: grid;
  padding: 14rpx;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14rpx;
}

.material-skeleton {
  box-sizing: border-box;
  height: 240rpx;
  padding: 8rpx;
  border: 1rpx solid rgba(83, 101, 95, 0.06);
  border-radius: 18rpx;
  background: var(--color-bg-surface);
}

.material-skeleton__image,
.material-skeleton__line {
  background: linear-gradient(90deg, #e2e8e3 25%, #f0f2ef 50%, #e2e8e3 75%);
  background-size: 200% 100%;
  animation: material-shimmer 1.3s ease-in-out infinite;
}

.material-skeleton__image {
  height: 128rpx;
  border-radius: 14rpx;
}

.material-skeleton__line {
  height: 16rpx;
  margin-top: 12rpx;
  border-radius: 8rpx;
}

.material-skeleton__line--short {
  width: 60%;
}

.material-error,
.material-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  padding: 50rpx;
  color: var(--color-text-secondary);
  flex-direction: column;
  text-align: center;
}

.material-error__title {
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 25rpx;
  font-weight: 500;
}

.material-error__description {
  margin-top: 10rpx;
  font-size: 17rpx;
  line-height: 1.5;
}

.material-error__retry {
  height: 58rpx;
  margin-top: 24rpx;
  padding: 0 26rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 18rpx;
  font-weight: 700;
}

@keyframes material-shimmer {
  from { background-position: 200% 0; }
  to { background-position: -20% 0; }
}

@media (prefers-reduced-motion: reduce) {
  .main-category,
  .material-card,
  .material-skeleton__image,
  .material-skeleton__line {
    transition: none;
    animation: none;
  }
}

.material-card__price {
  font-family: var(--font-number);
}
