:host {
  display: block;
}

.diy-modal {
  position: fixed;
  z-index: 10000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  color: var(--color-text-primary);
}

.diy-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(45, 53, 50, 0.34);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
}

.diy-modal--centered {
  box-sizing: border-box;
  padding: 30rpx;
  align-items: center;
}

.size-guide-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 620rpx;
  max-width: 100%;
  padding: 46rpx 34rpx 36rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 34rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 28rpx 80rpx rgba(43, 53, 49, 0.2);
  text-align: center;
  animation: wrist-modal-in 200ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.size-guide-card__title,
.size-guide-card__description {
  display: block;
}

.size-guide-card__title {
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 35rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.3;
}

.size-guide-card__description {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 19rpx;
  line-height: 1.55;
}

.size-guide-visual {
  display: flex;
  height: 208rpx;
  margin-top: 16rpx;
  align-items: center;
  justify-content: center;
  gap: 13rpx;
}

.size-guide-visual__bead {
  flex: 0 0 auto;
  box-sizing: border-box;
  border: 2rpx solid rgba(111, 143, 136, 0.3);
  border-radius: 50%;
  background: radial-gradient(circle at 32% 28%, #ffffff 0%, #e9f0ed 34%, #afc7c0 100%);
  box-shadow: inset -8rpx -10rpx 18rpx rgba(73, 105, 97, 0.18), 0 8rpx 18rpx rgba(43, 68, 62, 0.12);
}

.size-guide-visual__bead--small {
  width: 74rpx;
  height: 74rpx;
}

.size-guide-visual__bead--medium {
  width: 106rpx;
  height: 106rpx;
}

.size-guide-visual__bead--large {
  width: 146rpx;
  height: 146rpx;
}

.size-guide-visual__arrow {
  position: relative;
  width: 34rpx;
  height: 2rpx;
  flex: 0 0 34rpx;
  border-radius: 2rpx;
  background: #aeb8b4;
}

.size-guide-visual__arrow::after {
  position: absolute;
  top: -6rpx;
  right: 0;
  width: 12rpx;
  height: 12rpx;
  border-top: 2rpx solid #aeb8b4;
  border-right: 2rpx solid #aeb8b4;
  content: "";
  transform: rotate(45deg);
}

.size-guide-control {
  display: flex;
  box-sizing: border-box;
  width: 460rpx;
  max-width: 100%;
  height: 80rpx;
  margin: 0 auto;
  align-items: stretch;
  overflow: hidden;
  border: 1rpx solid rgba(83, 101, 95, 0.14);
  border-radius: 18rpx;
  background: var(--color-white);
}

.size-guide-control__action,
.size-guide-control__value {
  display: flex;
  align-items: center;
  justify-content: center;
}

.size-guide-control__action {
  box-sizing: border-box;
  width: 116rpx;
  min-width: 116rpx;
  max-width: 116rpx;
  height: 78rpx;
  flex: 0 0 116rpx;
  color: #52615d;
  font-size: 34rpx;
  font-weight: 650;
}

.size-guide-control__action:first-child {
  border-right: 1rpx solid rgba(83, 101, 95, 0.12);
}

.size-guide-control__action:last-child {
  border-left: 1rpx solid rgba(83, 101, 95, 0.12);
}

.size-guide-control__value {
  min-width: 0;
  flex: 1;
  color: var(--color-text-heading);
  font-size: 25rpx;
  font-weight: 700;
}

.size-guide-card--pressed {
  opacity: 0.97;
}

.diy-entry-mask {
  position: fixed;
  z-index: 30000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-page);
  opacity: 1;
  transition: opacity 180ms ease-out;
}

.diy-entry-mask--leaving {
  opacity: 0;
  pointer-events: none;
}

.diy-entry-mask__content {
  display: flex;
  align-items: center;
  width: 520rpx;
  margin-top: -24rpx;
  flex-direction: column;
  text-align: center;
}

.diy-entry-mask__beads {
  display: flex;
  height: 20rpx;
  margin-bottom: 30rpx;
  gap: 14rpx;
}

.diy-entry-mask__bead {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: var(--color-primary-muted);
  opacity: 0.25;
  animation: diy-entry-bead 1.2s ease-in-out infinite;
}

.diy-entry-mask__bead--two {
  background: #d7a39a;
  animation-delay: 160ms;
}

.diy-entry-mask__bead--three {
  animation-delay: 320ms;
}

.diy-entry-mask__status {
  color: var(--color-primary-pressed);
  font-family: "Songti SC", "STSong", serif;
  font-size: 27rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 1.5;
}

.diy-entry-mask__detail {
  margin-top: 14rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  line-height: 1.55;
}

.diy-entry-mask__retry {
  height: 70rpx;
  margin-top: 30rpx;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 70rpx;
}

.wrist-card,
.save-name-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  padding: 38rpx 36rpx calc(38rpx + env(safe-area-inset-bottom));
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 38rpx 38rpx 0 0;
  background: var(--color-bg-section);
  box-shadow: 0 -24rpx 64rpx rgba(62, 72, 68, 0.16);
  animation: diy-sheet-in 220ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.wrist-card::before,
.save-name-card::before {
  display: block;
  width: 70rpx;
  height: 7rpx;
  margin: -23rpx auto 23rpx;
  border-radius: 999rpx;
  background: rgba(96, 125, 118, 0.2);
  content: "";
}

.diy-modal--centered .wrist-card {
  width: 620rpx;
  max-width: 100%;
  max-height: calc(100vh - 60rpx);
  overflow-y: auto;
  padding: 28rpx 28rpx 30rpx;
  border-color: var(--color-border);
  border-radius: 34rpx;
  box-shadow: 0 28rpx 80rpx rgba(43, 53, 49, 0.2);
  animation: wrist-modal-in 200ms cubic-bezier(0.2, 0.75, 0.25, 1);
}

.diy-modal--centered .wrist-card::before {
  display: none;
}

.modal-eyebrow,
.modal-title,
.wrist-card__tip {
  display: block;
}

.modal-eyebrow {
  color: #9b817b;
  font-size: 15rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.modal-title {
  margin-top: 8rpx;
  margin-bottom: 27rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 34rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.wrist-card__header,
.wrist-card__heading,
.wrist-strands__heading {
  display: flex;
  align-items: center;
}

.wrist-card__header {
  width: 100%;
  justify-content: space-between;
}

.wrist-card__heading {
  min-width: 0;
  flex: 1;
  gap: 12rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.wrist-card__heading-icon {
  width: 29rpx;
  height: 29rpx;
}

.wrist-card__close {
  display: flex;
  box-sizing: border-box;
  width: 58rpx;
  min-width: 58rpx;
  max-width: 58rpx;
  height: 58rpx;
  margin: 0;
  padding: 0 0 4rpx;
  flex: 0 0 58rpx;
  align-items: center;
  justify-content: center;
  place-items: center;
  border: 0;
  border-radius: 50%;
  background: #f0eee8;
  color: var(--color-text-muted);
  font-size: 36rpx;
  font-weight: 300;
  line-height: 54rpx;
}

.wrist-card__close--pressed {
  background: #e7e4dd;
}

.wrist-card__close::after,
.wrist-strand-option::after,
.wrist-confirm::after,
.wrist-clear::after {
  display: none;
}

.wrist-estimator {
  box-sizing: border-box;
  margin-top: 18rpx;
  padding: 26rpx 22rpx 22rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 24rpx;
  background: var(--color-bg-warm);
}

.wrist-scale + .wrist-scale {
  margin-top: 27rpx;
  padding-top: 25rpx;
  border-top: 1rpx solid var(--color-divider);
}

.wrist-scale__heading,
.wrist-recommendation,
.wrist-recommendation__copy,
.wrist-recommendation__field,
.wrist-common__heading {
  display: flex;
  align-items: center;
}

.wrist-scale__heading {
  justify-content: space-between;
}

.wrist-scale__label {
  color: var(--color-text-heading);
  font-size: 23rpx;
  font-weight: 650;
}

.wrist-scale__value {
  color: var(--color-primary-pressed);
  font-size: 25rpx;
  font-weight: 700;
}

.wrist-scale__value text {
  margin-left: 3rpx;
  color: var(--color-text-muted);
  font-size: 17rpx;
  font-weight: 500;
}

.wrist-scale__ruler {
  position: relative;
  height: 84rpx;
  width: 512rpx;
  max-width: 100%;
  margin: 12rpx auto 0;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
}

.wrist-scale__scroller {
  width: 100%;
  height: 84rpx;
}

.wrist-scale__track {
  display: flex;
  height: 84rpx;
  align-items: flex-start;
  border-bottom: 2rpx solid rgba(80, 97, 91, 0.36);
}

.wrist-scale__edge {
  height: 1rpx;
  flex-grow: 0;
  flex-shrink: 0;
}

.wrist-scale__tick {
  position: relative;
  height: 84rpx;
  flex-grow: 0;
  flex-shrink: 0;
  text-align: center;
}

.wrist-scale__tick-line {
  width: 2rpx;
  height: 24rpx;
  margin: 18rpx auto 0;
  background: rgba(91, 108, 102, 0.42);
}

.wrist-scale__tick--major .wrist-scale__tick-line {
  height: 34rpx;
  margin-top: 8rpx;
  background: rgba(76, 94, 88, 0.62);
}

.wrist-scale__tick-label {
  display: block;
  width: 70rpx;
  margin-top: 8rpx;
  margin-left: -17rpx;
  color: var(--color-text-muted);
  font-size: 14rpx;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}

.wrist-scale__cursor {
  position: absolute;
  z-index: 2;
  top: 6rpx;
  bottom: 8rpx;
  left: 50%;
  width: 2rpx;
  background: var(--color-accent-blush-strong);
  pointer-events: none;
  transform: translateX(-1rpx);
}

.wrist-recommendation {
  position: relative;
  box-sizing: border-box;
  min-height: 94rpx;
  margin-top: 18rpx;
  padding: 14rpx 14rpx 14rpx 20rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 20rpx;
  background: var(--color-bg-surface);
}

.wrist-recommendation__copy {
  min-width: 0;
  flex: 1;
  align-items: flex-start;
  flex-direction: column;
}

.wrist-recommendation__label,
.wrist-recommendation__hint {
  display: block;
}

.wrist-recommendation__label {
  color: var(--color-accent-blush-strong);
  font-size: 21rpx;
  font-weight: 650;
}

.wrist-recommendation__hint {
  margin-top: 6rpx;
  color: var(--color-text-faint);
  font-size: 15rpx;
}

.wrist-recommendation__field {
  box-sizing: border-box;
  width: 172rpx;
  height: 64rpx;
  flex: 0 0 172rpx;
  padding: 0 15rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 15rpx;
  background: var(--color-bg-warm);
}

.wrist-recommendation__input {
  min-width: 0;
  height: 62rpx;
  flex: 1;
  color: var(--color-text-heading);
  font-size: 29rpx;
  font-weight: 700;
  line-height: 62rpx;
}

.wrist-recommendation__unit {
  margin-left: 6rpx;
  color: var(--color-text-faint);
  font-size: 18rpx;
}

.wrist-recommendation__reset {
  position: absolute;
  right: 14rpx;
  bottom: -33rpx;
  z-index: 2;
  padding: 8rpx 2rpx;
  color: var(--color-primary);
  font-size: 15rpx;
}

.wrist-common {
  margin-top: 25rpx;
}

.wrist-common__heading {
  justify-content: space-between;
}

.wrist-common__title {
  color: var(--color-text-heading);
  font-size: 22rpx;
  font-weight: 650;
}

.wrist-common__meta {
  color: var(--color-text-faint);
  font-size: 13rpx;
  letter-spacing: 2rpx;
}

.wrist-common__grid {
  display: grid;
  margin-top: 12rpx;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx;
}

.wrist-common__item {
  display: flex;
  min-width: 0;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 14rpx;
  background: var(--color-bg-surface);
  flex-direction: column;
}

.wrist-common__item--active {
  border-color: var(--color-primary-muted);
  background: var(--color-bg-primary-soft);
  box-shadow: inset 0 -3rpx 0 var(--color-primary-muted);
}

.wrist-common__item--pressed {
  transform: scale(0.97);
}

.wrist-common__size,
.wrist-common__label {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wrist-common__size {
  color: var(--color-text-heading);
  font-size: 22rpx;
  font-weight: 700;
}

.wrist-common__label {
  margin-top: 7rpx;
  color: var(--color-text-muted);
  font-size: 14rpx;
}

.wrist-card__tip {
  display: block;
  margin: 18rpx 6rpx 0;
  color: var(--color-text-secondary);
  font-size: 16rpx;
  line-height: 1.55;
  text-align: left;
}

.wrist-strands {
  margin-top: 24rpx;
}

.wrist-strands__heading {
  justify-content: space-between;
  color: #596761;
  font-size: 20rpx;
  font-weight: 650;
}

.wrist-strands__summary {
  color: #9a7e77;
  font-size: 17rpx;
  font-weight: 500;
}

.wrist-strands__options {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 20rpx;
  border: 1rpx solid rgba(91, 108, 102, 0.11);
  background: rgba(248, 247, 243, 0.72);
}

.wrist-strand-option {
  display: flex;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  min-height: 102rpx;
  margin: 0;
  padding: 17rpx 16rpx 18rpx;
  flex: 1 1 0;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  border: 0;
  background: transparent;
  color: var(--color-text-secondary);
  line-height: 1;
  transition: background-color 140ms ease, box-shadow 140ms ease, color 140ms ease;
}

.wrist-strand-option + .wrist-strand-option {
  border-left: 1rpx solid rgba(91, 108, 102, 0.1);
}

.wrist-strand-option__title-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.wrist-strand-option__radio {
  display: flex;
  box-sizing: border-box;
  width: 27rpx;
  height: 27rpx;
  flex: 0 0 27rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid var(--color-border-strong);
  border-radius: 50%;
  background: var(--color-bg-surface);
  transition: border-color 140ms ease, background-color 140ms ease;
}

.wrist-strand-option__radio-core {
  width: 13rpx;
  height: 13rpx;
  border-radius: 50%;
  background: transparent;
  transform: scale(0.5);
  transition: background-color 140ms ease, transform 140ms ease;
}

.wrist-strand-option__title,
.wrist-strand-option__description {
  display: block;
  max-width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wrist-strand-option__title {
  color: #59645f;
  font-size: 23rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.wrist-strand-option__description {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 17rpx;
  font-weight: 400;
  line-height: 1.25;
}

.wrist-strand-option--pressed {
  background: rgba(108, 137, 130, 0.06);
}

.wrist-strand-option--active {
  background: rgba(255, 255, 252, 0.92);
  box-shadow: inset 0 -4rpx 0 var(--color-primary), 0 5rpx 16rpx rgba(66, 79, 74, 0.055);
}

.wrist-strand-option--active .wrist-strand-option__title {
  color: var(--color-primary-pressed);
}

.wrist-strand-option--active .wrist-strand-option__radio {
  border-color: var(--color-primary);
  background: var(--color-bg-primary-soft);
}

.wrist-strand-option--active .wrist-strand-option__radio-core {
  background: var(--color-primary);
  transform: scale(1);
}

.wrist-strand-option--active .wrist-strand-option__description {
  color: var(--color-text-secondary);
}

.wrist-actions {
  display: flex;
  width: 100%;
  margin-top: 28rpx;
  gap: 14rpx;
}

.wrist-confirm,
.wrist-clear {
  display: flex;
  box-sizing: border-box;
  width: 0;
  min-width: 0;
  height: 78rpx;
  margin: 0;
  padding: 0;
  flex: 1 1 0;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 39rpx;
  font-size: 21rpx;
  font-weight: 650;
  line-height: 1;
}

.wrist-confirm {
  background: #303936;
  color: var(--color-white);
}

.wrist-clear {
  border: 1rpx solid rgba(171, 144, 92, 0.22);
  background: #f7f2e8;
  color: #4f5754;
}

.wrist-action--pressed {
  opacity: 0.78;
}

.save-name-card__title {
  margin-bottom: 10rpx;
}

.save-name-card__tip {
  display: block;
  color: var(--color-text-secondary);
  font-size: 20rpx;
  line-height: 1.55;
}

.save-name-field {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  padding: 0 22rpx;
  align-items: center;
  border: 1rpx solid rgba(96, 125, 118, 0.16);
  border-radius: 20rpx;
  background: #eeefeb;
}

.save-name-field__input {
  min-width: 0;
  height: 88rpx;
  flex: 1;
  color: var(--color-text-primary);
  font-size: 25rpx;
  line-height: 88rpx;
}

.save-name-field__count {
  margin-left: 16rpx;
  color: #9aa39f;
  font-size: 18rpx;
  white-space: nowrap;
}

.save-name-actions {
  display: grid;
  margin-top: 24rpx;
  grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
  gap: 14rpx;
}

.save-name-actions__button {
  width: 100%;
  height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 76rpx;
}

.save-name-actions__button::after {
  display: none;
}

.save-name-actions__button--secondary {
  border: 1rpx solid var(--color-border);
  background: var(--color-bg-section);
  color: var(--color-primary);
}

.save-name-actions__button--primary {
  background: var(--color-primary);
  box-shadow: 0 10rpx 24rpx var(--color-shadow-primary);
  color: var(--color-white);
}

.save-name-actions__button[disabled] {
  box-shadow: none;
  opacity: 0.42;
}

@keyframes diy-entry-bead {
  0%,
  70%,
  100% {
    opacity: 0.25;
    transform: translateY(0) scale(0.82);
  }

  35% {
    opacity: 0.9;
    transform: translateY(-8rpx) scale(1);
  }
}

@keyframes diy-sheet-in {
  from { transform: translateY(24rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .size-guide-card,
  .wrist-card,
  .save-name-card {
    animation: none;
  }
}

@keyframes wrist-modal-in {
  from { transform: translateY(12rpx) scale(0.98); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
