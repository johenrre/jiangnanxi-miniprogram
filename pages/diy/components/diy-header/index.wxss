:host {
  display: block;
  box-sizing: border-box;
  width: 100vw;
  min-width: 100vw;
}

.diy-header {
  position: relative;
  z-index: 5;
  width: 100vw;
  border-bottom: 1rpx solid var(--color-divider);
  background: rgba(246, 244, 239, 0.97);
  color: var(--color-text-primary);
}

.diy-summary,
.diy-summary__numbers,
.diy-guide-button {
  display: flex;
  align-items: center;
}

.diy-summary {
  box-sizing: border-box;
  width: 100%;
  min-height: 82rpx;
  padding: 9rpx 30rpx 13rpx;
  gap: 18rpx;
}

.diy-summary__primary {
  width: 198rpx;
  min-width: 198rpx;
}

.diy-summary__eyebrow,
.diy-summary__fit-label {
  display: block;
  color: #8b9591;
  font-size: 16rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.diy-summary__numbers {
  min-width: 0;
  margin-top: 6rpx;
  gap: 9rpx;
  white-space: nowrap;
}

.diy-summary__price {
  color: var(--color-accent-blush);
  font-size: 26rpx;
  font-weight: 800;
  line-height: 1;
}

.diy-summary__dot {
  width: 5rpx;
  height: 5rpx;
  flex: 0 0 5rpx;
  border-radius: 50%;
  background: var(--color-accent-jade);
}

.diy-summary__count {
  color: #747f7b;
  font-size: 18rpx;
  font-weight: 600;
  line-height: 1;
}

.diy-summary__fit {
  box-sizing: border-box;
  min-width: 0;
  padding-left: 18rpx;
  flex: 1;
  border-left: 1rpx solid var(--color-border-hairline);
}

.diy-summary__fit-label {
  color: #8b9591;
}

.diy-summary__wrist {
  display: block;
  max-width: 100%;
  margin-top: 6rpx;
  overflow: hidden;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.2;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.diy-guide-button {
  justify-content: center;
  width: 124rpx;
  min-width: 124rpx;
  height: 50rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 124rpx;
  border: 0;
  border-radius: 25rpx;
  background: var(--color-primary);
  box-shadow: 0 7rpx 18rpx var(--color-shadow-primary);
  color: var(--color-white);
  font-size: 18rpx;
  font-weight: 700;
  gap: 7rpx;
  transition: opacity 100ms ease, transform 100ms ease;
}

.diy-guide-button::after {
  display: none;
}

.diy-guide-button--pressed {
  opacity: 0.65;
  transform: scale(0.97);
}

.diy-guide-button__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 24rpx;
  height: 24rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.62);
  border-radius: 50%;
  color: var(--color-white);
  font-size: 16rpx;
  font-weight: 700;
  line-height: 1;
}

@media (prefers-reduced-motion: reduce) {
  .diy-guide-button {
    transition: none;
  }
}
