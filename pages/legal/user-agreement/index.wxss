.agreement-page {
  min-height: 100vh;
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 100% 8%, rgba(167, 200, 192, 0.13), transparent 26%),
    var(--color-bg-page);
  color: var(--color-text-primary);
}

.agreement-hero {
  padding: 30rpx 38rpx 34rpx;
  border-bottom: 1rpx solid var(--color-border-soft);
  background: rgba(252, 251, 247, 0.72);
}

.agreement-hero__eyebrow,
.agreement-hero__title,
.agreement-hero__meta,
.agreement-hero__description,
.agreement-section__title,
.agreement-section__paragraph {
  display: block;
}

.agreement-hero__eyebrow {
  color: #9b817b;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.agreement-hero__title {
  margin-top: 12rpx;
  color: var(--color-text-heading);
  font-family: "Songti SC", "STSong", serif;
  font-size: 44rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
}

.agreement-hero__meta {
  margin-top: 13rpx;
  color: var(--color-text-muted);
  font-size: 19rpx;
}

.agreement-hero__description {
  margin-top: 11rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.65;
}

.agreement-content {
  padding: 28rpx 30rpx 0;
}

.agreement-tabs {
  display: flex;
  margin: 26rpx 30rpx 0;
  padding: 6rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 18rpx;
  background: rgba(252, 251, 247, 0.72);
  gap: 6rpx;
}

.agreement-tab {
  height: 68rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 13rpx;
  background: transparent;
  color: var(--color-text-muted);
  flex: 1;
  font-size: 21rpx;
  line-height: 68rpx;
}

.agreement-tab::after,
.privacy-card__button::after {
  display: none;
}

.agreement-tab--active {
  background: var(--color-primary);
  color: var(--color-white);
  font-weight: 600;
}

.privacy-content {
  padding: 28rpx 30rpx 0;
}

.privacy-card {
  padding: 32rpx 28rpx;
  border: 1rpx solid rgba(96, 125, 118, 0.09);
  border-radius: 22rpx;
  background: rgba(252, 251, 247, 0.92);
  box-shadow: 0 8rpx 22rpx var(--color-shadow-soft);
}

.privacy-card__title,
.privacy-card__description,
.privacy-content__note {
  display: block;
}

.privacy-card__title {
  color: var(--color-text-heading);
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.45;
}

.privacy-card__description {
  margin-top: 17rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.82;
}

.privacy-card__button {
  height: 78rpx;
  margin: 28rpx 0 0;
  border-radius: 17rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.privacy-content__note {
  margin: 18rpx 8rpx 0;
  color: var(--color-text-faint);
  font-size: 19rpx;
  line-height: 1.65;
}

.agreement-section {
  margin-bottom: 18rpx;
  padding: 27rpx 26rpx;
  border: 1rpx solid rgba(96, 125, 118, 0.09);
  border-radius: 20rpx;
  background: rgba(252, 251, 247, 0.9);
  box-shadow: 0 8rpx 22rpx var(--color-shadow-soft);
}

.agreement-section__title {
  color: var(--color-text-heading);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 600;
  line-height: 1.45;
}

.agreement-section__paragraph {
  margin-top: 15rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.82;
  text-align: justify;
}
