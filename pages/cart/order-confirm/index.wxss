.confirm-page {
  display: flex;
  height: 100vh;
  overflow: hidden;
  flex-direction: column;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.confirm-scroll {
  min-height: 0;
  height: auto;
  flex: 1;
}

.confirm-content {
  padding: 20rpx 24rpx 0;
}

.confirm-card {
  padding: 25rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 22rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 9rpx 26rpx var(--color-shadow-soft);
}

.confirm-card + .confirm-card,
.confirm-payment-result + .confirm-card {
  margin-top: 18rpx;
}

.confirm-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirm-card__title {
  display: block;
  color: #4b5552;
  font-family: "Songti SC", "STSong", serif;
  font-size: 28rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.confirm-card__action {
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 600;
}

.confirm-card__meta {
  color: var(--color-text-muted);
  font-size: 19rpx;
}

.confirm-address {
  position: relative;
  overflow: hidden;
}

.confirm-address::before {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 5rpx;
  background: repeating-linear-gradient(
    90deg,
    #99b2ab 0 34rpx,
    #e8d5cf 34rpx 68rpx,
    transparent 68rpx 76rpx
  );
  content: "";
  opacity: 0.7;
}

.confirm-address__person {
  display: flex;
  align-items: center;
  margin-top: 22rpx;
  gap: 15rpx;
}

.confirm-address__name {
  color: var(--color-text-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.confirm-address__phone {
  color: #6e7c78;
  font-size: 21rpx;
}

.confirm-address__default {
  padding: 4rpx 9rpx;
  border-radius: 8rpx;
  background: var(--color-bg-primary-soft);
  color: var(--color-primary);
  font-size: 15rpx;
  font-weight: 600;
}

.confirm-address__detail {
  display: block;
  margin-top: 12rpx;
  color: #6e7a76;
  font-size: 21rpx;
  line-height: 1.65;
}

.confirm-address__empty {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 19rpx;
  border-radius: 14rpx;
  background: var(--color-bg-muted);
  color: #71807b;
  font-size: 21rpx;
}

.confirm-product {
  display: flex;
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border-soft);
  gap: 18rpx;
}

.confirm-product__preview {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 160rpx;
  overflow: hidden;
  border-radius: 18rpx;
  background: var(--color-bg-media);
}

.confirm-product__image {
  width: 100%;
  height: 100%;
  padding: 10rpx;
}

.confirm-product__image--mall {
  padding: 0;
}

.confirm-product__fallback {
  color: var(--color-primary-light);
  font-family: "Songti SC", "STSong", serif;
  font-size: 38rpx;
}

.confirm-product__copy {
  min-width: 0;
  flex: 1;
}

.confirm-product__type,
.confirm-product__name,
.confirm-product__unit,
.confirm-product__total {
  display: block;
}

.confirm-product__type {
  color: var(--color-primary-light);
  font-size: 16rpx;
  font-weight: 650;
  letter-spacing: 1rpx;
}

.confirm-product__name {
  margin-top: 5rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 26rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.confirm-service-group {
  margin-top: 24rpx;
}

.confirm-service-group + .confirm-service-group {
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.confirm-service-group__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
  gap: 16rpx;
}

.confirm-service-group__title {
  color: #53615d;
  font-size: 22rpx;
  font-weight: 600;
}

.confirm-service-group__benefit {
  color: #8d746a;
  font-size: 17rpx;
}

.confirm-service-group__list {
  overflow: hidden;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 17rpx;
  background: #f6f5f0;
}

.confirm-service {
  display: flex;
  box-sizing: border-box;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  min-width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 15rpx 17rpx;
  border-bottom: 1rpx solid var(--color-border-soft);
  border-radius: 0;
  background: transparent;
  line-height: normal;
  text-align: left;
  gap: 14rpx;
}

.confirm-service:last-child {
  border-bottom: 0;
}

.confirm-service::after {
  display: none;
}

.confirm-service--selected {
  background: #e8efeb;
}

.confirm-service__image {
  width: 86rpx;
  height: 86rpx;
  flex: 0 0 86rpx;
  border-radius: 14rpx;
  background: #ecece7;
}

.confirm-service__radio {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex: 0 0 32rpx;
  border: 2rpx solid #a6b2ae;
  border-radius: 50%;
  background: var(--color-bg-surface);
}

.confirm-service--selected .confirm-service__radio {
  border-color: var(--color-primary-light);
}

.confirm-service__radio-core {
  width: 17rpx;
  height: 17rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
}

.confirm-service__copy {
  min-width: 0;
  flex: 1;
}

.confirm-service__title,
.confirm-service__subtitle {
  display: block;
}

.confirm-service__threshold {
  display: block;
  margin-top: 5rpx;
  color: #9a8176;
  font-size: 17rpx;
  line-height: 1.4;
}

.confirm-service__threshold--reached {
  color: #66887f;
  font-weight: 600;
}

.confirm-service__title {
  color: var(--color-text-primary);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.35;
}

.confirm-service__subtitle {
  margin-top: 5rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
  line-height: 1.45;
}

.confirm-service__price {
  color: var(--color-accent-blush-strong);
  font-size: 20rpx;
  font-weight: 650;
  white-space: nowrap;
}

.confirm-greeting {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.confirm-greeting__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.confirm-greeting__heading > view {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.confirm-greeting__title {
  color: #53615d;
  font-size: 22rpx;
  font-weight: 600;
}

.confirm-greeting__required {
  padding: 3rpx 8rpx;
  border-radius: 7rpx;
  color: #9b625b;
  background: rgba(217, 163, 154, 0.14);
  font-size: 15rpx;
}

.confirm-greeting__count {
  color: var(--color-text-muted);
  font-size: 17rpx;
}

.confirm-greeting__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 142rpx;
  margin-top: 14rpx;
  padding: 17rpx 18rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 15rpx;
  color: var(--color-text-primary);
  background: #f8f7f3;
  font-size: 21rpx;
  line-height: 1.65;
}

.confirm-greeting__placeholder {
  color: #a2aaa6;
}

.confirm-greeting__hint {
  display: block;
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 17rpx;
  line-height: 1.55;
}

.confirm-remark__input {
  box-sizing: border-box;
  width: 100%;
  min-height: 116rpx;
  margin-top: 19rpx;
  padding: 18rpx 19rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: #f6f5f0;
  color: var(--color-text-primary);
  font-size: 21rpx;
  line-height: 1.6;
}

.confirm-remark__placeholder {
  color: #a2aaa6;
}

.confirm-product__unit {
  margin-top: 7rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.confirm-product__options {
  margin-top: 13rpx;
  padding: 11rpx 13rpx;
  border-radius: 12rpx;
  background: var(--color-bg-muted);
}

.confirm-product__option {
  display: flex;
  justify-content: space-between;
  color: #73807c;
  font-size: 17rpx;
  line-height: 1.65;
  gap: 10rpx;
}

.confirm-product__total {
  margin-top: 11rpx;
  color: var(--color-accent-blush-strong);
  font-size: 26rpx;
  font-weight: 700;
  text-align: right;
}

.confirm-delivery__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 18rpx;
  border: 1rpx solid rgba(111, 143, 136, 0.22);
  border-radius: 16rpx;
  background: #e9efeb;
}

.confirm-delivery__title,
.confirm-delivery__subtitle {
  display: block;
}

.confirm-delivery__title {
  color: #4b5854;
  font-size: 23rpx;
  font-weight: 600;
}

.confirm-delivery__subtitle {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 18rpx;
}

.confirm-delivery__price {
  color: var(--color-primary);
  font-size: 21rpx;
  font-weight: 700;
}

.confirm-fees__row,
.confirm-fees__total {
  display: flex;
  justify-content: space-between;
}

.confirm-fees__row {
  margin-top: 20rpx;
  color: #6e7a76;
  font-size: 21rpx;
}

.confirm-fees__total {
  align-items: flex-end;
  margin-top: 22rpx;
  padding-top: 19rpx;
  border-top: 1rpx solid var(--color-border-soft);
  font-size: 24rpx;
  font-weight: 600;
}

.confirm-fees__total text:last-child {
  color: var(--color-accent-blush-strong);
  font-size: 33rpx;
  font-weight: 700;
}

.confirm-payment-result {
  margin-top: 18rpx;
  padding: 21rpx 23rpx;
  border: 1rpx solid rgba(183, 124, 114, 0.18);
  border-radius: 18rpx;
  background: rgba(242, 226, 221, 0.66);
}

.confirm-payment-result--success {
  border-color: rgba(111, 143, 136, 0.19);
  background: var(--color-bg-primary-soft);
}

.confirm-payment-result__title,
.confirm-payment-result__message,
.confirm-payment-result__order {
  display: block;
}

.confirm-payment-result__title {
  color: #6d5752;
  font-size: 22rpx;
  font-weight: 600;
}

.confirm-payment-result__message {
  margin-top: 8rpx;
  color: #876f69;
  font-size: 19rpx;
  line-height: 1.55;
}

.confirm-payment-result--success .confirm-payment-result__title,
.confirm-payment-result--success .confirm-payment-result__message {
  color: #56716a;
}

.confirm-payment-result__order {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 17rpx;
  word-break: break-all;
}

.confirm-payment-result__actions {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  gap: 12rpx;
}

.confirm-payment-result__action {
  height: 56rpx;
  margin: 0;
  padding: 0 22rpx;
  border-radius: 15rpx;
  font-size: 19rpx;
  font-weight: 600;
  line-height: 54rpx;
}

.confirm-payment-result__action--query {
  border: 1rpx solid var(--color-primary-light);
  color: var(--color-white);
  background: var(--color-primary-light);
}

.confirm-payment-result__action--cancel {
  border: 1rpx solid rgba(155, 98, 91, 0.24);
  color: #8d625c;
  background: rgba(255, 255, 255, 0.5);
}

.confirm-content__safe-space {
  height: 24rpx;
}

.confirm-footer {
  position: relative;
  z-index: 100;
  display: flex;
  align-items: center;
  margin: 0 20rpx calc(16rpx + env(safe-area-inset-bottom));
  padding: 13rpx 13rpx 13rpx 22rpx;
  flex: 0 0 auto;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 25rpx;
  background: var(--color-surface-glass-strong);
  box-shadow: 0 14rpx 36rpx var(--color-shadow);
  -webkit-backdrop-filter: blur(18rpx);
  backdrop-filter: blur(18rpx);
  gap: 20rpx;
}

.confirm-footer__amount {
  min-width: 0;
  flex: 1;
}

.confirm-footer__label,
.confirm-footer__price {
  display: block;
}

.confirm-footer__label {
  color: var(--color-text-muted);
  font-size: 17rpx;
}

.confirm-footer__price {
  margin-top: 4rpx;
  color: var(--color-accent-blush-strong);
  font-size: 33rpx;
  font-weight: 700;
}

.confirm-footer__button {
  width: 240rpx;
  height: 78rpx;
  flex: 0 0 240rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  box-shadow: 0 10rpx 24rpx rgba(79, 105, 98, 0.15);
  color: var(--color-white);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 78rpx;
}

.confirm-footer__button--completed {
  background: var(--color-primary-muted);
}

.confirm-loading {
  padding: 24rpx;
}

.confirm-loading__card {
  height: 186rpx;
  margin-bottom: 18rpx;
  border-radius: 22rpx;
  background: linear-gradient(105deg, #e5e7e2 20%, var(--color-bg-muted) 45%, #e5e7e2 70%);
  background-size: 220% 100%;
  animation: confirm-skeleton 1.2s ease-in-out infinite;
}

.confirm-loading__card--large {
  height: 360rpx;
}

.confirm-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 720rpx;
  padding: 80rpx 74rpx;
  flex-direction: column;
  text-align: center;
}

.confirm-state__icon {
  width: 88rpx;
  height: 88rpx;
  opacity: 0.48;
}

.confirm-state__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 82rpx;
  height: 82rpx;
  border: 1rpx solid rgba(183, 124, 114, 0.18);
  border-radius: 50%;
  background: rgba(242, 226, 221, 0.7);
  color: var(--color-accent-blush);
  font-family: "Songti SC", "STSong", serif;
  font-size: 36rpx;
  font-weight: 500;
}

.confirm-state__title {
  margin-top: 24rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 500;
}

.confirm-state__description {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.confirm-state__button {
  height: 70rpx;
  margin-top: 28rpx;
  padding: 0 36rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 70rpx;
}

@keyframes confirm-skeleton {
  from { background-position: 200% 0; }
  to { background-position: -200% 0; }
}
