.mall-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  background: #f6f6f6;
  color: #333333;
  font-family: var(--font-body);
}

.mall-hero {
  position: relative;
  width: 100%;
  height: 380rpx;
  overflow: hidden;
  background: #e8e8e8;
}

.mall-hero--fallback {
  background:
    radial-gradient(circle at 78% 42%, rgba(167, 200, 192, 0.42), transparent 34%),
    linear-gradient(135deg, #fbf9f4, #e9efeb);
}

.mall-hero__image {
  display: block;
  width: 100%;
  height: 100%;
}

.mall-filter {
  position: sticky;
  z-index: 18;
  top: 0;
  padding: 10rpx 0 14rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.55);
  background: rgba(246, 246, 246, 0.84);
  -webkit-backdrop-filter: blur(24rpx);
  backdrop-filter: blur(24rpx);
}

.mall-primary,
.mall-secondary {
  display: block;
  width: 100%;
  white-space: nowrap;
}

.mall-primary__track,
.mall-secondary__track {
  display: inline-flex;
  align-items: center;
  box-sizing: border-box;
  min-width: 100%;
}

.mall-primary__track {
  padding: 20rpx 30rpx 10rpx;
}

.mall-secondary__track {
  padding: 4rpx 30rpx 0;
}

.mall-primary__item,
.mall-secondary__item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  box-sizing: border-box;
  background: transparent;
  white-space: nowrap;
  transition: color 120ms ease, opacity 100ms ease;
}

.mall-primary__item {
  margin-right: 40rpx;
  padding-bottom: 15rpx;
  color: #666666;
  font-size: 30rpx;
  line-height: 1;
}

.mall-primary__item:last-child,
.mall-secondary__item:last-child {
  margin-right: 0;
}

.mall-primary__item--active {
  color: #333333;
  font-weight: 700;
}

.mall-primary__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 50rpx;
  height: 3rpx;
  border-radius: 25rpx;
  background: #b28277;
  transform: translateX(-50%);
}

.mall-secondary__item {
  min-height: 52rpx;
  margin-right: 34rpx;
  padding: 0 2rpx 8rpx;
  color: #999999;
  font-size: 24rpx;
  line-height: 1;
}

.mall-secondary__item--active {
  color: #333333;
  font-weight: 600;
}

.mall-secondary__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  width: 28rpx;
  height: 2rpx;
  border-radius: 2rpx;
  background: #b28277;
  transform: translateX(-50%);
}

.mall-filter-button--pressed {
  opacity: 0.54;
}

.mall-products {
  display: grid;
  padding: 10rpx 24rpx 40rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 3%;
  row-gap: 24rpx;
}

.mall-product-card {
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  color: #333333;
  line-height: normal;
  text-align: left;
  transition: opacity 100ms ease, transform 120ms ease;
}

.mall-product-card::after {
  display: none;
}

.mall-product-card--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.mall-product-card__media {
  position: relative;
  width: 100%;
  height: 340rpx;
  overflow: hidden;
  background: #fafafa;
}

.mall-product-card__image,
.mall-product-card__fallback {
  display: block;
  width: 100%;
  height: 100%;
}

.mall-product-card__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #edf1ed, #f8f6f1);
}

.mall-product-card__fallback-ring {
  width: 148rpx;
  height: 148rpx;
  border: 22rpx solid rgba(111, 143, 136, 0.13);
  border-radius: 50%;
}

.mall-product-card__tag {
  position: absolute;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.84);
  color: #666666;
  font-size: 20rpx;
  font-weight: 500;
  line-height: 1.2;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.mall-product-card__body {
  padding: 20rpx 16rpx;
}

.mall-product-card__title {
  display: -webkit-box;
  margin-bottom: 8rpx;
  overflow: hidden;
  color: #333333;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mall-product-card__meta,
.mall-product-card__price-row,
.mall-product-card__price-group {
  display: flex;
  align-items: center;
}

.mall-product-card__meta {
  justify-content: space-between;
  margin-bottom: 16rpx;
  color: #999999;
  font-size: 22rpx;
  line-height: 1.3;
}

.mall-product-card__price-row {
  justify-content: space-between;
  color: #333333;
}

.mall-product-card__price-group {
  min-width: 0;
  align-items: baseline;
}

.mall-product-card__currency {
  margin-right: 2rpx;
  font-family: var(--font-number);
  font-size: 24rpx;
  font-weight: 700;
}

.mall-product-card__price {
  font-family: var(--font-number);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.mall-product-card__original-price {
  margin-left: 8rpx;
  color: #aaaaaa;
  font-family: var(--font-number);
  font-size: 19rpx;
  text-decoration: line-through;
}

.mall-product-card__link {
  flex: 0 0 auto;
  margin-left: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #f3efec;
  color: #8b726b;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1;
}

.mall-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 440rpx;
  padding: 50rpx;
  flex-direction: column;
  text-align: center;
}

.mall-empty__ring {
  width: 94rpx;
  height: 94rpx;
  border: 14rpx solid rgba(111, 143, 136, 0.12);
  border-radius: 50%;
}

.mall-empty__title {
  margin-top: 26rpx;
  color: #4b5552;
  font-family: var(--font-body);
  font-size: 28rpx;
}

.mall-empty__description {
  margin-top: 10rpx;
  color: #999999;
  font-size: 20rpx;
}

.mall-empty__button {
  height: 70rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 70rpx;
}

.mall-empty__button::after {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .mall-primary__item,
  .mall-secondary__item,
  .mall-product-card {
    transition: none;
  }
}
