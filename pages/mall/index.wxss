.mall-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(178rpx + env(safe-area-inset-bottom));
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.mall-hero {
  position: relative;
  height: 248rpx;
  margin: 14rpx 24rpx 0;
  overflow: hidden;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 24rpx;
  background: var(--color-bg-primary-soft);
}

.mall-hero--fallback {
  background:
    radial-gradient(circle at 78% 42%, rgba(167, 200, 192, 0.42), transparent 34%),
    linear-gradient(135deg, #fbf9f4, #e9efeb);
}

.mall-hero__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.mall-hero::after {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, rgba(248, 246, 240, 0.82), rgba(248, 246, 240, 0.24) 58%, transparent 78%);
  content: "";
  pointer-events: none;
}

.mall-hero__copy {
  position: absolute;
  z-index: 2;
  top: 50%;
  left: 28rpx;
  display: flex;
  max-width: 330rpx;
  flex-direction: column;
  transform: translateY(-50%);
}

.mall-hero__eyebrow {
  color: #8e7772;
  font-size: 13rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.mall-hero__title {
  margin-top: 12rpx;
  color: var(--color-text-heading);
  font-family: var(--font-display);
  font-size: 36rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.mall-hero__description {
  margin-top: 10rpx;
  color: #74817d;
  font-size: 18rpx;
  letter-spacing: 1rpx;
}

.mall-filter {
  margin-top: 14rpx;
  padding: 0 24rpx 8rpx;
  background: var(--color-bg-page);
}

.mall-primary,
.mall-secondary {
  display: block;
  width: 100%;
  overflow: hidden;
}

.mall-primary__track,
.mall-secondary__track {
  display: grid;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  grid-auto-flow: column;
  justify-content: start;
}

.mall-primary__track {
  border-bottom: 1rpx solid var(--color-border-soft);
  grid-auto-columns: 104rpx;
}

.mall-primary__item,
.mall-secondary__item {
  position: relative;
  display: grid;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1;
  white-space: nowrap;
  transition: color 120ms ease, opacity 100ms ease;
}

.mall-product-card::after {
  display: none;
}

.mall-primary__item {
  height: 66rpx;
  color: #7c8783;
  font-size: 24rpx;
}

.mall-primary__item--active {
  color: #4b615b;
  font-weight: 600;
}

.mall-primary__indicator,
.mall-secondary__indicator {
  position: absolute;
  bottom: 0;
  left: 50%;
  height: 2rpx;
  border-radius: 2rpx;
  background: var(--color-primary-light);
  transform: translateX(-50%);
}

.mall-primary__indicator {
  width: 34rpx;
}

.mall-secondary__track {
  grid-auto-columns: 88rpx;
}

.mall-secondary__item {
  height: 54rpx;
  color: #84908c;
  font-size: 20rpx;
}

.mall-secondary__item--active {
  color: var(--color-primary);
  font-weight: 600;
}

.mall-secondary__indicator {
  width: 24rpx;
}

.mall-filter-button--pressed {
  opacity: 0.54;
}

.mall-products {
  display: grid;
  padding: 22rpx 24rpx 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx 18rpx;
}

.mall-product-card {
  min-width: 0;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 22rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 9rpx 24rpx var(--color-shadow-soft);
  color: var(--color-text-primary);
  text-align: left;
  transition: opacity 100ms ease, transform 120ms ease;
}

.mall-product-card--pressed {
  opacity: 0.82;
  transform: scale(0.985);
}

.mall-product-card__media {
  position: relative;
  height: 324rpx;
  overflow: hidden;
  background: var(--color-bg-media);
}

.mall-product-card__image,
.mall-product-card__fallback {
  width: 100%;
  height: 100%;
}

.mall-product-card__fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #edf1ed, #f8f6f1);
}

.mall-product-card__fallback-ring {
  width: 148rpx;
  height: 148rpx;
  border: 22rpx solid rgba(111, 143, 136, 0.13);
  border-radius: 50%;
}

.mall-product-card__tag {
  position: absolute;
  top: 13rpx;
  left: 13rpx;
  padding: 7rpx 13rpx;
  border-radius: 12rpx;
  background: rgba(252, 251, 247, 0.86);
  color: #657b75;
  font-size: 15rpx;
  font-weight: 600;
  line-height: 1;
  -webkit-backdrop-filter: blur(10rpx);
  backdrop-filter: blur(10rpx);
}

.mall-product-card__body {
  padding: 17rpx 17rpx 18rpx;
}

.mall-product-card__title {
  display: -webkit-box;
  min-height: 62rpx;
  overflow: hidden;
  color: var(--color-text-primary);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.mall-product-card__meta,
.mall-product-card__price-row,
.mall-product-card__price-group {
  display: flex;
  align-items: center;
}

.mall-product-card__meta {
  justify-content: space-between;
  margin-top: 9rpx;
  color: #929b97;
  font-size: 17rpx;
}

.mall-product-card__price-row {
  justify-content: space-between;
  margin-top: 15rpx;
  color: var(--color-accent-blush-strong);
}

.mall-product-card__price-group {
  min-width: 0;
  align-items: baseline;
}

.mall-product-card__currency {
  margin-right: 3rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.mall-product-card__price {
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1;
}

.mall-product-card__original-price {
  margin-left: 9rpx;
  color: #a4aaa7;
  font-size: 16rpx;
  text-decoration: line-through;
}

.mall-product-card__link {
  margin-left: 8rpx;
  color: var(--color-primary-light);
  font-size: 17rpx;
  font-weight: 600;
}

.mall-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 440rpx;
  padding: 50rpx;
  flex-direction: column;
  text-align: center;
}

.mall-empty__ring {
  width: 94rpx;
  height: 94rpx;
  border: 14rpx solid rgba(111, 143, 136, 0.12);
  border-radius: 50%;
}

.mall-empty__title {
  margin-top: 26rpx;
  color: #4b5552;
  font-family: var(--font-body);
  font-size: 28rpx;
}

.mall-empty__description {
  margin-top: 10rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
}

.mall-empty__button {
  height: 70rpx;
  margin-top: 28rpx;
  padding: 0 32rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 22rpx;
  line-height: 70rpx;
}

.mall-empty__button::after {
  display: none;
}

@media (prefers-reduced-motion: reduce) {
  .mall-primary__item,
  .mall-secondary__item,
  .mall-product-card {
    transition: none;
  }
}

.mall-product-card__price,
.mall-product-card__original-price {
  font-family: var(--font-number);
}
