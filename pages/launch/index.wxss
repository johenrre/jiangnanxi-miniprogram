page {
  width: 100%;
  height: 100%;
  overflow: hidden;
  background: var(--color-bg-page);
}

.launch-page {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
  background: var(--color-bg-page);
  color: var(--color-text-heading);
}

.launch-page__image,
.launch-page__veil {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.launch-page__veil {
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.12) 0%, transparent 38%),
    linear-gradient(0deg, rgba(246, 246, 246, 0.92) 0%, rgba(246, 246, 246, 0.1) 34%, transparent 58%);
}

.launch-page__brand {
  position: absolute;
  top: calc(118rpx + env(safe-area-inset-top));
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
}

.launch-page__mark {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(173, 149, 104, 0.34);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  box-shadow: inset 0 0 0 8rpx rgba(255, 255, 255, 0.28);
}

.launch-page__mark--image {
  box-sizing: border-box;
  padding: 4rpx;
  background: rgba(255, 255, 255, 0.72);
}

.launch-page__name {
  margin-top: 12rpx;
  font-family: var(--font-display);
  font-size: 42rpx;
  font-weight: 500;
  letter-spacing: 9rpx;
}

.launch-page__slogan {
  margin-top: 13rpx;
  color: rgba(51, 51, 51, 0.62);
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.launch-page__status {
  position: absolute;
  right: 64rpx;
  bottom: calc(72rpx + env(safe-area-inset-bottom));
  left: 64rpx;
}

.launch-page__status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(51, 51, 51, 0.68);
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.launch-page__track {
  height: 3rpx;
  margin-top: 17rpx;
  overflow: hidden;
  background: rgba(173, 149, 104, 0.16);
}

.launch-page__progress {
  height: 100%;
  background: var(--color-primary);
  transition: width 220ms ease-out;
}

@media (prefers-reduced-motion: reduce) {
  .launch-page__progress { transition: none; }
}
