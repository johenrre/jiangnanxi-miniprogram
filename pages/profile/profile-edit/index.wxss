.profile-edit-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.profile-edit-content {
  padding: 26rpx 30rpx 80rpx;
}

.profile-edit-avatar-card {
  display: flex;
  align-items: center;
  padding: 32rpx 30rpx 30rpx;
  border-radius: 26rpx;
  background:
    radial-gradient(circle at 78% 18%, rgba(215, 163, 154, 0.14), transparent 30%),
    var(--color-bg-surface);
  box-shadow: 0 10rpx 28rpx var(--color-shadow-soft);
  flex-direction: column;
}

.profile-edit-avatar-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 148rpx;
  margin: 0;
  padding: 0;
  overflow: visible;
  background: transparent;
  font-size: 0;
  line-height: 1;
}

.profile-edit-avatar-frame {
  position: relative;
  width: 148rpx;
  min-width: 148rpx;
  max-width: 148rpx;
  height: 148rpx;
  min-height: 148rpx;
  max-height: 148rpx;
  flex: 0 0 148rpx;
  border-radius: 50%;
}

.profile-edit-avatar {
  position: absolute;
  inset: 0;
  overflow: hidden;
  width: 100%;
  height: 100%;
  border: 5rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  background: #eeeeee;
  box-shadow: 0 10rpx 28rpx var(--color-shadow);
  color: var(--color-primary);
  font-family: var(--font-body);
  font-size: 44rpx;
  font-weight: 500;
}

.profile-edit-avatar__edit {
  position: absolute;
  right: -2rpx;
  bottom: 2rpx;
  height: 42rpx;
  padding: 0 14rpx;
  border: 3rpx solid var(--color-bg-surface);
  border-radius: 14rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 36rpx;
}

.profile-edit-avatar-card__hint {
  margin-top: 22rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.profile-edit-form {
  overflow: hidden;
  margin-top: 24rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 23rpx;
  background: var(--color-bg-surface);
}

.profile-edit-field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 19rpx 26rpx;
  border-bottom: 1rpx solid var(--color-border-soft);
  gap: 22rpx;
}

.profile-edit-field:last-child {
  border-bottom: 0;
}

.profile-edit-field__label {
  width: 130rpx;
  flex: 0 0 130rpx;
  color: var(--color-text-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.profile-edit-field__input,
.profile-edit-field__value {
  min-width: 0;
  flex: 1;
  color: var(--color-text-primary);
  font-size: 26rpx;
  text-align: right;
}

.profile-edit-field__value {
  color: var(--color-text-muted);
}

.profile-edit-save,
.profile-edit-logout,
.profile-edit-login__button {
  width: 100%;
  height: 84rpx;
  margin-top: 28rpx;
  border-radius: 19rpx;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 84rpx;
}

.profile-edit-save,
.profile-edit-login__button {
  background: var(--color-primary);
  box-shadow: 0 11rpx 25rpx rgba(0, 0, 0, 0.1);
  color: var(--color-white);
}

.profile-edit-logout {
  margin-top: 14rpx;
  border: 1rpx solid rgba(183, 124, 114, 0.19);
  background: transparent;
  color: var(--color-accent-blush-strong);
}

.profile-edit-login {
  padding: 16rpx 30rpx 80rpx;
}

.profile-edit-login__button {
  margin-top: -42rpx;
}
