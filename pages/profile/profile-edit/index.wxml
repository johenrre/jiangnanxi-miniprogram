<theme-provider>
<view class="profile-edit-page">
  <page-header title="个人资料" />

  <view wx:if="{{status === 'ready'}}" class="profile-edit-content">
    <view class="profile-edit-avatar-card">
      <button class="profile-edit-avatar-button" open-type="chooseAvatar" bindchooseavatar="handleAvatarChoose">
        <view class="profile-edit-avatar-frame">
          <image
            wx:if="{{avatarUrl && !avatarLoadFailed}}"
            class="profile-edit-avatar"
            src="{{avatarUrl}}"
            mode="aspectFill"
            binderror="handleAvatarError"
          />
          <image
            wx:else
            class="profile-edit-avatar"
            src="/assets/profile/default-avatar.svg"
            mode="aspectFit"
            aria-label="江南禧默认头像"
          />
          <view class="profile-edit-avatar__edit">更换</view>
        </view>
      </button>
      <text class="profile-edit-avatar-card__hint">选择头像后，点击保存才会上传</text>
    </view>

    <view class="profile-edit-form">
      <view class="profile-edit-field">
        <text class="profile-edit-field__label">昵称</text>
        <input
          class="profile-edit-field__input"
          type="nickname"
          value="{{nickname}}"
          maxlength="24"
          placeholder="请输入昵称"
          bindinput="handleNicknameInput"
        />
      </view>
      <view class="profile-edit-field profile-edit-field--readonly">
        <text class="profile-edit-field__label">手机号</text>
        <text class="profile-edit-field__value">{{(profile && profile.phone) || '暂未绑定'}}</text>
      </view>
      <view class="profile-edit-field profile-edit-field--readonly">
        <text class="profile-edit-field__label">用户编号</text>
        <text class="profile-edit-field__value">{{(profile && profile.id) || '--'}}</text>
      </view>
    </view>

    <button class="profile-edit-save" loading="{{saving}}" disabled="{{saving}}" bindtap="handleSave">保存资料</button>
    <button class="profile-edit-logout" bindtap="handleLogout">退出登录</button>
  </view>

  <content-state
    wx:elif="{{status === 'loading'}}"
    status="loading"
    title="正在加载个人资料"
    description="请稍候"
  />

  <view wx:elif="{{status === 'login'}}" class="profile-edit-login">
    <content-state
      status="login"
      title="登录后管理个人资料"
      description="登录后可修改头像和昵称，并查看账户绑定信息。"
    />
    <button
      class="profile-edit-login__button"
      open-type="getPhoneNumber"
      loading="{{loginLoading}}"
      bindgetphonenumber="handlePhoneLogin"
    >登录</button>
  </view>

  <content-state
    wx:else
    status="error"
    title="个人资料加载失败"
    description="{{errorMessage}}"
    actionText="重新加载"
    bindaction="handleRetry"
  />
</view>
</theme-provider>
