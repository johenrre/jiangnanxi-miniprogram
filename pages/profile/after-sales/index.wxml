<theme-provider>
<view class="after-sales-page">
  <page-header title="退款与售后" />

  <view class="after-sales-tabs">
    <button
      class="after-sales-tab {{section === 'records' ? 'after-sales-tab--active' : ''}}"
      data-section="records"
      bindtap="handleSectionChange"
    >售后记录 <text>{{records.length}}</text></button>
    <button
      class="after-sales-tab {{section === 'eligible' ? 'after-sales-tab--active' : ''}}"
      data-section="eligible"
      bindtap="handleSectionChange"
    >申请售后 <text>{{eligibleOrders.length}}</text></button>
  </view>

  <block wx:if="{{status === 'ready'}}">
    <view wx:if="{{section === 'records'}}" class="after-sales-list">
      <block wx:if="{{records.length}}">
        <view class="after-sales-card" wx:for="{{records}}" wx:key="id">
          <view
            class="after-sales-card__summary"
            hover-class="after-sales-card__summary--pressed"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{expandedOrderId === item.id ? '收起售后详情' : '查看售后详情'}}"
            bindtap="handleRecordToggle"
          >
            <view class="after-sales-card__head">
              <text class="after-sales-card__number">订单 {{item.orderNo}}</text>
              <text class="after-sales-card__status">{{item.statusLabel}}</text>
            </view>
            <view class="after-sales-card__body">
              <view class="after-sales-card__mark">售</view>
              <view class="after-sales-card__copy">
                <text class="after-sales-card__title">{{item.title}}</text>
                <text class="after-sales-card__reason">{{item.refundReason || '申请已提交，等待处理'}}</text>
                <text class="after-sales-card__date">{{item.createdAtText}}</text>
              </view>
              <text class="after-sales-card__amount">{{item.amountText}}</text>
            </view>
            <view class="after-sales-card__detail-entry">
              <text>{{expandedOrderId === item.id ? '收起详情' : '查看售后详情'}}</text>
              <view class="after-sales-card__chevron {{expandedOrderId === item.id ? 'after-sales-card__chevron--up' : ''}}"></view>
            </view>
          </view>

          <view wx:if="{{expandedOrderId === item.id}}" class="after-sales-detail">
            <view class="after-sales-detail__row">
              <text class="after-sales-detail__label">当前进度</text>
              <text class="after-sales-detail__value after-sales-detail__value--status">{{item.afterSaleStatusLabel}}</text>
            </view>
            <view class="after-sales-detail__row after-sales-detail__row--top">
              <text class="after-sales-detail__label">申请原因</text>
              <text class="after-sales-detail__value">{{item.refundReason || '未填写'}}</text>
            </view>
            <view wx:if="{{item.refundDescription}}" class="after-sales-detail__row after-sales-detail__row--top">
              <text class="after-sales-detail__label">申请说明</text>
              <text class="after-sales-detail__value">{{item.refundDescription}}</text>
            </view>
            <view wx:if="{{item.refundEvidenceUrls.length}}" class="after-sales-detail__evidence">
              <text class="after-sales-detail__label">申请凭证</text>
              <view class="after-sales-detail__evidence-list">
                <image wx:for="{{item.refundEvidenceUrls}}" wx:key="*this" src="{{item}}" mode="aspectFill" />
              </view>
            </view>
            <view wx:if="{{item.refundAdminRemark}}" class="after-sales-detail__row after-sales-detail__row--top">
              <text class="after-sales-detail__label">商家回复</text>
              <text class="after-sales-detail__value">{{item.refundAdminRemark}}</text>
            </view>
            <block wx:if="{{item.refundType === 'return_refund' && item.refundStatus !== 'rejected'}}">
              <view wx:if="{{item.refundReturnAddress}}" class="after-sales-detail__address">
                <view class="after-sales-detail__address-head">
                  <text class="after-sales-detail__label">退货地址</text>
                  <button
                    class="after-sales-detail__copy"
                    data-address="{{item.refundReturnAddress}}"
                    catchtap="handleCopyAddress"
                  >复制地址</button>
                </view>
                <text class="after-sales-detail__address-text" user-select="{{true}}">{{item.refundReturnAddress}}</text>
              </view>
              <view wx:else class="after-sales-detail__notice">
                商家审核通过后会在这里显示退货地址，请暂时不要寄回商品。
              </view>

              <view wx:if="{{item.refundReturnExpressNo && editingReturnOrderId !== item.id}}" class="after-sales-detail__return-logistics">
                <view class="after-sales-detail__address-head">
                  <text class="after-sales-detail__label">寄回物流</text>
                  <button
                    class="after-sales-detail__copy"
                    data-tracking-no="{{item.refundReturnExpressNo}}"
                    catchtap="handleCopyReturnTracking"
                  >复制单号</button>
                </view>
                <text class="after-sales-detail__return-company">{{item.refundReturnExpressCompany}}</text>
                <text class="after-sales-detail__return-no" user-select="{{true}}">{{item.refundReturnExpressNo}}</text>
                <text class="after-sales-detail__return-time">提交时间 {{item.refundReturnShippedAt || '—'}}</text>
              </view>

              <button
                wx:if="{{item.canSubmitReturnShipment && editingReturnOrderId !== item.id}}"
                class="after-sales-detail__return-action"
                data-id="{{item.id}}"
                bindtap="handleStartReturnShipment"
              >{{item.refundReturnExpressNo ? '修改退货物流' : '填写退货物流'}}</button>

              <view wx:if="{{editingReturnOrderId === item.id}}" class="after-sales-detail__return-form">
                <text class="after-sales-detail__return-form-title">填写寄回信息</text>
                <picker
                  mode="selector"
                  range="{{returnExpressNames}}"
                  value="{{returnExpressIndex}}"
                  bindchange="handleReturnExpressChange"
                >
                  <view class="after-sales-detail__field">
                    <text>快递公司</text>
                    <view><text>{{returnExpressNames[returnExpressIndex]}}</text><view class="after-sales-detail__field-chevron"></view></view>
                  </view>
                </picker>
                <view class="after-sales-detail__field">
                  <text>快递单号</text>
                  <input
                    value="{{returnExpressNo}}"
                    maxlength="64"
                    placeholder="请输入寄回快递单号"
                    placeholder-class="after-sales-detail__field-placeholder"
                    bindinput="handleReturnExpressNoInput"
                  />
                </view>
                <view class="after-sales-detail__return-buttons">
                  <button disabled="{{submittingReturnShipment}}" bindtap="handleCancelReturnShipment">取消</button>
                  <button class="after-sales-detail__return-submit" loading="{{submittingReturnShipment}}" disabled="{{submittingReturnShipment}}" bindtap="handleSubmitReturnShipment">确认提交</button>
                </view>
              </view>
            </block>

            <view wx:if="{{item.canReapplyAfterSale}}" class="after-sales-detail__reapply">
              <view>
                <text>仍需售后？</text>
                <text>可修改原因、说明和图片凭证后重新提交。</text>
              </view>
              <button
                data-order-no="{{item.orderNo}}"
                bindtap="handleReapply"
              >重新申请</button>
            </view>
          </view>
        </view>
      </block>
      <content-state
        wx:else
        status="empty"
        title="暂无售后记录"
        description="定制商品仅支持在商家发货前申请售后。"
      />
    </view>

    <view wx:else class="after-sales-list">
      <block wx:if="{{eligibleOrders.length}}">
        <view class="after-sales-card" wx:for="{{eligibleOrders}}" wx:key="id">
          <view class="after-sales-card__head">
            <text class="after-sales-card__number">订单 {{item.orderNo}}</text>
            <text class="after-sales-card__status after-sales-card__status--eligible">可申请</text>
          </view>
          <view class="after-sales-card__body">
            <view class="after-sales-card__mark">单</view>
            <view class="after-sales-card__copy">
              <text class="after-sales-card__title">{{item.title}}</text>
              <text class="after-sales-card__reason">{{item.statusLabel}} · {{item.createdAtText}}</text>
            </view>
            <text class="after-sales-card__amount">{{item.amountText}}</text>
          </view>
          <view class="after-sales-card__footer">
            <text>提交前请确认问题原因</text>
            <button
              class="after-sales-card__apply"
              data-id="{{item.id}}"
              bindtap="handleApply"
            >申请售后</button>
          </view>
        </view>
      </block>
      <content-state
        wx:else
        status="empty"
        title="暂无可申请订单"
        description="只有已付款且尚未发货的订单可申请售后。"
      />
    </view>
  </block>

  <content-state
    wx:elif="{{status === 'loading'}}"
    status="loading"
    title="正在加载售后信息"
    description="正在同步订单与售后状态"
  />
  <content-state
    wx:elif="{{status === 'empty'}}"
    status="empty"
    title="暂无售后信息"
    description="当前没有售后记录，也没有可申请售后的订单。"
  />
  <content-state
    wx:elif="{{status === 'login'}}"
    status="login"
    title="登录后查看售后"
    description="登录后可查看处理进度并从符合条件的订单发起申请。"
    actionText="登录"
    bindaction="handleGoLogin"
  />
  <content-state
    wx:else
    status="error"
    title="售后信息加载失败"
    description="{{errorMessage}}"
    actionText="重新加载"
    bindaction="handleRetry"
  />
  <phone-login-modal id="phone-login-modal" />
</view>
</theme-provider>
