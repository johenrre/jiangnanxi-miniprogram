.after-sales-page {
  min-height: 100vh;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
}

.after-sales-tabs {
  display: grid;
  padding: 14rpx 28rpx 0;
  border-bottom: 1rpx solid var(--color-border-soft);
  background: rgba(246, 244, 239, 0.96);
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.after-sales-tab {
  position: relative;
  height: 68rpx;
  border-radius: 0;
  color: var(--color-text-muted);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 68rpx;
}

.after-sales-tab text {
  margin-left: 6rpx;
  color: #a2aaa6;
  font-size: 17rpx;
}

.after-sales-tab--active {
  color: #58736c;
  font-weight: 700;
}

.after-sales-tab--active::after {
  position: absolute;
  right: 22rpx;
  bottom: 0;
  left: 22rpx;
  height: 4rpx;
  border-radius: 4rpx;
  background: var(--color-primary-muted);
  content: "";
}

.after-sales-list {
  padding: 22rpx 26rpx 80rpx;
}

.after-sales-card {
  overflow: hidden;
  margin-bottom: 18rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 22rpx;
  background: var(--color-bg-surface);
  box-shadow: 0 9rpx 26rpx var(--color-shadow-soft);
}

.after-sales-card__summary {
  display: block;
  width: 100%;
  margin: 0;
  padding: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: normal;
  text-align: left;
  white-space: normal;
  transition: background-color 120ms ease;
}

.after-sales-card__summary .after-sales-card__head,
.after-sales-card__summary .after-sales-card__body,
.after-sales-card__summary .after-sales-card__detail-entry {
  width: 100%;
}

.after-sales-card__summary--pressed {
  background: rgba(96, 125, 118, 0.045);
}

.after-sales-card__head,
.after-sales-card__footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 19rpx 23rpx;
}

.after-sales-card__head {
  border-bottom: 1rpx solid var(--color-border-soft);
}

.after-sales-card__number,
.after-sales-card__footer {
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.after-sales-card__number {
  min-width: 0;
  overflow: hidden;
  flex: 1;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.after-sales-card__status {
  flex: 0 0 auto;
  color: var(--color-accent-blush-strong);
  font-size: 20rpx;
  font-weight: 700;
  white-space: nowrap;
}

.after-sales-card__status--eligible {
  color: var(--color-primary);
}

.after-sales-card__body {
  display: flex;
  align-items: center;
  padding: 23rpx;
  gap: 18rpx;
}

.after-sales-card__mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  flex: 0 0 74rpx;
  border-radius: 19rpx;
  background: #f0e8e1;
  color: #9b766c;
  font-family: "Songti SC", "STSong", serif;
  font-size: 24rpx;
  font-weight: 500;
}

.after-sales-card__copy {
  min-width: 0;
  flex: 1;
}

.after-sales-card__title,
.after-sales-card__reason,
.after-sales-card__date {
  display: block;
}

.after-sales-card__title {
  overflow: hidden;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.after-sales-card__reason,
.after-sales-card__date {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.after-sales-card__amount {
  align-self: flex-start;
  color: var(--color-accent-blush-strong);
  font-size: 23rpx;
  font-weight: 700;
}

.after-sales-card__footer {
  border-top: 1rpx solid var(--color-border-soft);
}

.after-sales-card__detail-entry {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-height: 64rpx;
  padding: 0 23rpx;
  border-top: 1rpx solid var(--color-border-soft);
  color: var(--color-primary);
  font-size: 18rpx;
  gap: 12rpx;
}

.after-sales-card__chevron {
  width: 11rpx;
  height: 11rpx;
  border-right: 2rpx solid var(--color-primary-light);
  border-bottom: 2rpx solid var(--color-primary-light);
  transform: rotate(45deg) translateY(-3rpx);
  transition: transform 180ms ease;
}

.after-sales-card__chevron--up {
  transform: rotate(225deg) translate(-2rpx, -1rpx);
}

.after-sales-detail {
  padding: 22rpx 23rpx 24rpx;
  border-top: 1rpx solid var(--color-border-soft);
  background: rgba(246, 244, 239, 0.56);
}

.after-sales-detail__row,
.after-sales-detail__address-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.after-sales-detail__row--top {
  align-items: flex-start;
  margin-top: 17rpx;
}

.after-sales-detail__label {
  flex: 0 0 auto;
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.after-sales-detail__value {
  min-width: 0;
  color: #4c5854;
  font-size: 19rpx;
  line-height: 1.55;
  text-align: right;
}

.after-sales-detail__value--status {
  color: var(--color-accent-blush-strong);
  font-weight: 600;
}

.after-sales-detail__address {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg-surface);
}

.after-sales-detail__return-logistics,
.after-sales-detail__return-form {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 16rpx;
  background: var(--color-bg-surface);
}

.after-sales-detail__return-company,
.after-sales-detail__return-no,
.after-sales-detail__return-time {
  display: block;
}

.after-sales-detail__return-company {
  margin-top: 15rpx;
  color: #4c5854;
  font-size: 21rpx;
  font-weight: 600;
}

.after-sales-detail__return-no {
  margin-top: 7rpx;
  color: var(--color-primary);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 20rpx;
  letter-spacing: 1rpx;
}

.after-sales-detail__return-time {
  margin-top: 9rpx;
  color: #959e9a;
  font-size: 17rpx;
}

.after-sales-detail__return-action {
  width: 100%;
  height: 70rpx;
  margin-top: 18rpx;
  border: 1rpx solid rgba(96, 125, 118, 0.22);
  border-radius: 16rpx;
  color: var(--color-primary);
  background: rgba(252, 251, 247, 0.88);
  font-size: 20rpx;
  font-weight: 600;
  line-height: 68rpx;
}

.after-sales-detail__return-form-title {
  display: block;
  margin-bottom: 5rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 25rpx;
}

.after-sales-detail__field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  border-bottom: 1rpx solid var(--color-border-soft);
  gap: 20rpx;
}

.after-sales-detail__field > text {
  flex: 0 0 auto;
  color: var(--color-text-muted);
  font-size: 18rpx;
}

.after-sales-detail__field > view {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  color: #4c5854;
  font-size: 19rpx;
  gap: 12rpx;
}

.after-sales-detail__field input {
  min-width: 0;
  height: 78rpx;
  flex: 1;
  color: #4c5854;
  font-size: 19rpx;
  text-align: right;
}

.after-sales-detail__field-placeholder {
  color: #abb2ae;
}

.after-sales-detail__field-chevron {
  width: 11rpx;
  height: 11rpx;
  border-right: 2rpx solid var(--color-primary-muted);
  border-bottom: 2rpx solid var(--color-primary-muted);
  transform: rotate(45deg) translateY(-3rpx);
}

.after-sales-detail__return-buttons {
  display: grid;
  margin-top: 20rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.after-sales-detail__return-buttons button {
  height: 64rpx;
  margin: 0;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 15rpx;
  color: #7c8883;
  background: var(--color-bg-page);
  font-size: 19rpx;
  line-height: 62rpx;
}

.after-sales-detail__return-buttons .after-sales-detail__return-submit {
  border-color: var(--color-primary);
  color: var(--color-white);
  background: var(--color-primary);
}

.after-sales-detail__copy {
  height: 48rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(96, 125, 118, 0.22);
  border-radius: 14rpx;
  color: var(--color-primary);
  font-size: 17rpx;
  font-weight: 600;
  line-height: 46rpx;
}

.after-sales-detail__address-text {
  display: block;
  margin-top: 14rpx;
  color: #4c5854;
  font-size: 19rpx;
  line-height: 1.65;
}

.after-sales-detail__notice {
  margin-top: 20rpx;
  padding: 17rpx 19rpx;
  border-radius: 14rpx;
  background: rgba(206, 188, 150, 0.15);
  color: #7d725d;
  font-size: 18rpx;
  line-height: 1.6;
}

.after-sales-detail__reapply {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(183,124,114,.16);
  border-radius: 16rpx;
  background: rgba(217,163,154,.08);
  gap: 18rpx;
}

.after-sales-detail__reapply > view {
  min-width: 0;
  flex: 1;
}

.after-sales-detail__reapply > view text {
  display: block;
}

.after-sales-detail__reapply > view text:first-child {
  color: #795f59;
  font-size: 21rpx;
  font-weight: 600;
}

.after-sales-detail__reapply > view text:last-child {
  margin-top: 6rpx;
  color: #93817c;
  font-size: 17rpx;
  line-height: 1.55;
}

.after-sales-detail__reapply button {
  flex: 0 0 auto;
  min-width: 126rpx;
  height: 66rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 1rpx solid var(--color-border-strong);
  border-radius: 14rpx;
  color: var(--color-primary);
  background: var(--color-bg-surface);
  font-size: 19rpx;
  line-height: 64rpx;
}

.after-sales-detail__reapply button::after {
  border: 0;
}

.after-sales-detail__evidence {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.after-sales-detail__evidence-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 13rpx;
  gap: 12rpx;
}

.after-sales-detail__evidence-list image {
  width: 112rpx;
  height: 112rpx;
  border-radius: 14rpx;
  background: #eceae4;
}

.after-sales-card__apply {
  height: 52rpx;
  padding: 0 21rpx;
  border-radius: 15rpx;
  background: var(--color-primary);
  color: var(--color-white);
  font-size: 19rpx;
  font-weight: 600;
  line-height: 52rpx;
}

button::after {
  border: 0;
}
