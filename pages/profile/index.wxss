.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 190rpx;
  overflow: hidden;
  background:
    radial-gradient(circle at 100% 18%, rgba(167, 200, 192, 0.11), transparent 28%),
    var(--color-bg-page);
  color: var(--color-text-primary);
}

.profile-hero {
  position: relative;
  padding: 14rpx 30rpx 38rpx;
  overflow: hidden;
}

.profile-hero__wash {
  position: absolute;
  top: -126rpx;
  right: -126rpx;
  width: 390rpx;
  height: 390rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 50%;
  background:
    radial-gradient(circle at 42% 44%, rgba(255, 255, 255, 0.82), transparent 4%),
    radial-gradient(circle at 62% 63%, rgba(217, 163, 154, 0.16), transparent 6%),
    radial-gradient(circle at 50% 50%, rgba(167, 200, 192, 0.17), rgba(246, 244, 239, 0) 68%);
  pointer-events: none;
}

.profile-hero__heading {
  position: relative;
  z-index: 1;
  padding: 12rpx 7rpx 30rpx;
}

.profile-hero__eyebrow,
.profile-hero__title,
.profile-hero__subtitle {
  display: block;
}

.profile-hero__eyebrow {
  color: #9b817b;
  font-size: 14rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.profile-hero__title {
  margin-top: 12rpx;
  color: var(--color-text-heading);
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.profile-hero__subtitle {
  margin-top: 11rpx;
  color: var(--color-text-secondary);
  font-size: 21rpx;
  line-height: 1.55;
}

.profile-identity {
  position: relative;
  z-index: 1;
  display: flex;
  box-sizing: border-box;
  align-items: center;
  min-height: 0;
  padding: 12rpx 18rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 20rpx;
  background: var(--color-surface-glass-strong);
  box-shadow: 0 8rpx 22rpx var(--color-shadow-soft);
  gap: 16rpx;
}

.profile-identity__avatar-shell {
  position: relative;
  width: 78rpx;
  height: 78rpx;
  flex: 0 0 78rpx;
}

.profile-identity__avatar {
  box-sizing: border-box;
  width: 78rpx;
  height: 78rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.94);
  border-radius: 50%;
  background: #edf0eb;
  box-shadow: 0 8rpx 22rpx var(--color-shadow);
}

.profile-identity__avatar--fallback {
  position: relative;
  display: grid;
  place-items: center;
  background: linear-gradient(145deg, var(--color-bg-section), #e4ebe6);
}

.profile-identity__avatar-ring {
  width: 44rpx;
  height: 44rpx;
  border: 2rpx solid rgba(96, 125, 118, 0.34);
  border-radius: 50%;
}

.profile-identity__avatar-stone {
  position: absolute;
  width: 15rpx;
  height: 21rpx;
  border: 2rpx solid rgba(96, 125, 118, 0.58);
  transform: rotate(45deg);
}

.profile-identity__copy {
  display: flex;
  box-sizing: border-box;
  height: 60rpx;
  align-self: center;
  justify-content: flex-start;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-identity__name,
.profile-identity__description {
  display: block;
}

.profile-identity__name {
  height: 36rpx;
  min-width: 0;
  overflow: hidden;
  flex: 0 0 36rpx;
  color: var(--color-text-heading);
  font-family: "Songti SC", "STSong", serif;
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__description {
  height: 22rpx;
  margin-top: 2rpx;
  flex: 0 0 22rpx;
  color: var(--color-text-secondary);
  font-size: 17rpx;
  line-height: 22rpx;
}

.profile-identity__action {
  box-sizing: border-box;
  width: 72rpx;
  min-width: 72rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 72rpx;
  border: 0;
  border-radius: 10rpx;
  background: transparent;
  color: var(--color-primary);
  font-size: 17rpx;
  font-weight: 600;
  line-height: 58rpx;
  transition: opacity 100ms ease, transform 120ms ease;
}

.profile-identity__action::after {
  display: none;
}

.profile-identity__action--login {
  width: 94rpx;
  min-width: 94rpx;
  height: 56rpx;
  flex-basis: 94rpx;
  border-radius: 14rpx;
  background: var(--color-primary);
  color: var(--color-white);
  line-height: 56rpx;
}

.profile-identity__action--pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.profile-error,
.profile-syncing {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
  min-height: 58rpx;
  margin: 13rpx 6rpx 0;
  padding: 9rpx 14rpx;
  border-radius: 13rpx;
  background: rgba(252, 251, 247, 0.7);
  color: var(--color-text-secondary);
  font-size: 18rpx;
}

.profile-error__text {
  min-width: 0;
  flex: 1;
  color: #aa7067;
}

.profile-error__retry {
  height: 40rpx;
  margin-left: 14rpx;
  padding: 0 12rpx;
  color: var(--color-primary);
  font-size: 17rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.profile-syncing {
  justify-content: center;
  gap: 11rpx;
}

.profile-syncing__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary-muted);
  animation: profile-pulse 1s ease-in-out infinite;
}

.profile-section {
  padding: 1rpx 30rpx 42rpx;
}

.profile-section__heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 14rpx 6rpx 22rpx;
}

.profile-section__eyebrow,
.profile-section__title {
  display: block;
}

.profile-section__eyebrow {
  color: #9b817b;
  font-size: 13rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.profile-section__title {
  margin-top: 7rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 35rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.profile-section__hint {
  padding-bottom: 5rpx;
  color: var(--color-text-faint);
  font-size: 17rpx;
}

.profile-entry-list {
  overflow: hidden;
  border: 1rpx solid rgba(96, 125, 118, 0.085);
  border-radius: 22rpx;
  background: rgba(252, 251, 247, 0.88);
  box-shadow: 0 9rpx 26rpx var(--color-shadow-soft);
}

.profile-entry {
  display: flex;
  align-items: center;
  width: 100%;
  min-width: 100%;
  min-height: 105rpx;
  padding: 16rpx 21rpx;
  border-bottom: 1rpx solid var(--color-border-soft);
  border-radius: 0;
  background: transparent;
  text-align: left;
  gap: 18rpx;
}

.profile-entry:last-child {
  border-bottom: 0;
}

.profile-entry--pressed {
  background: var(--color-bg-muted);
}

.profile-entry__icon-shell {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  flex: 0 0 60rpx;
  border-radius: 18rpx;
  background: var(--color-bg-primary-soft);
}

.profile-entry__icon-shell--1,
.profile-entry__icon-shell--3 {
  background: #f2eae4;
}

.profile-entry__icon-shell--2 {
  background: #edf0f2;
}

.profile-entry__icon-shell--legal {
  background: #edf1ef;
}

.profile-entry__icon {
  width: 34rpx;
  height: 34rpx;
}

.profile-entry__copy {
  min-width: 0;
  flex: 1;
}

.profile-entry__label,
.profile-entry__description {
  display: block;
}

.profile-entry__label {
  color: var(--color-text-primary);
  font-size: 25rpx;
  font-weight: 600;
}

.profile-entry__description {
  margin-top: 6rpx;
  color: var(--color-text-muted);
  font-size: 18rpx;
  line-height: 1.45;
}

.profile-entry__arrow {
  width: 25rpx;
  height: 25rpx;
  flex: 0 0 25rpx;
  opacity: 0.32;
  transform: rotate(180deg);
}

@keyframes profile-pulse {
  50% { opacity: 0.35; transform: scale(0.8); }
}

@media (prefers-reduced-motion: reduce) {
  .profile-identity__action {
    animation: none;
    transition: none;
  }
}
