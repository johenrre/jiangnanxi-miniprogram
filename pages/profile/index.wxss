.profile-page {
  position: relative;
  min-height: 100vh;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-family: var(--font-body);
}

.profile-hero {
  position: relative;
  box-sizing: border-box;
  height: 500rpx;
  padding: 0;
  overflow: visible;
  background: var(--color-bg-muted);
}

.profile-hero__backdrop {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
}

.profile-hero__wash,
.profile-hero__heading {
  display: none;
}

.profile-identity {
  position: absolute;
  z-index: 2;
  right: 24rpx;
  bottom: -116rpx;
  left: 24rpx;
  box-sizing: border-box;
  min-height: 0;
  padding: 38rpx 30rpx 30rpx;
  border: 0;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.05);
}

.profile-identity__main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-identity__avatar-shell {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex: 0 0 120rpx;
}

.profile-identity__avatar {
  display: block;
  box-sizing: border-box;
  width: 120rpx;
  height: 120rpx;
  border: 4rpx solid #ffffff;
  border-radius: 50%;
  background: #eeeeee;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.1);
}

.profile-identity__copy {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.profile-identity__name,
.profile-identity__description {
  display: block;
}

.profile-identity__name {
  max-width: 100%;
  overflow: hidden;
  color: #333333;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__description {
  box-sizing: border-box;
  max-width: 100%;
  margin-top: 10rpx;
  padding: 4rpx 14rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f5f1e9;
  color: #8f774c;
  font-size: 23rpx;
  line-height: 1.3;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-identity__action {
  box-sizing: border-box;
  width: 72rpx;
  min-width: 72rpx;
  height: 44rpx;
  margin: 0;
  padding: 0 16rpx;
  flex: 0 0 72rpx;
  border: 1rpx solid #dddddd;
  border-radius: 22rpx;
  background: #ffffff;
  color: #999999;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 42rpx;
  transition: opacity 100ms ease, transform 120ms ease;
}

.profile-identity__action::after {
  display: none;
}

.profile-identity__action--login {
  width: 92rpx;
  min-width: 92rpx;
  flex-basis: 92rpx;
  border-color: var(--color-primary);
  background: var(--color-primary);
  color: #ffffff;
}

.profile-identity__action--pressed {
  opacity: 0.72;
  transform: scale(0.975);
}

.profile-stats {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 1rpx dashed #eeeeee;
}

.profile-stat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 0;
  min-width: 0;
  min-height: 74rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: normal;
  flex: 1 1 0;
  flex-direction: column;
}

.profile-stat::after {
  display: none;
}

.profile-stat--pressed {
  opacity: 0.65;
}

.profile-stat__number,
.profile-stat__label {
  display: block;
}

.profile-stat__number {
  color: #333333;
  font-family: var(--font-number);
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.profile-stat__number--order {
  color: var(--color-accent-red);
}

.profile-stat__label {
  margin-top: 6rpx;
  color: #999999;
  font-size: 29rpx;
  line-height: 1.2;
}

.profile-error,
.profile-syncing {
  position: absolute;
  z-index: 3;
  right: 30rpx;
  bottom: -186rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  min-height: 58rpx;
  padding: 9rpx 14rpx;
  border-radius: 13rpx;
  background: rgba(255, 255, 255, 0.94);
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.profile-error__text {
  min-width: 0;
  flex: 1;
  color: var(--color-accent-blush-strong);
}

.profile-error__retry {
  height: 40rpx;
  margin-left: 14rpx;
  padding: 0 12rpx;
  color: var(--color-primary-muted);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.profile-syncing {
  justify-content: center;
  gap: 11rpx;
}

.profile-syncing__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary-muted);
  animation: profile-pulse 1s ease-in-out infinite;
}

.profile-section {
  box-sizing: border-box;
  margin: 170rpx 24rpx 40rpx;
  padding: 30rpx;
  border-radius: 24rpx;
  background: #ffffff;
}

.profile-section__heading {
  display: block;
  padding: 0;
  margin-bottom: 40rpx;
}

.profile-section__eyebrow,
.profile-section__hint {
  display: none;
}

.profile-section__title {
  display: block;
  padding-left: 10rpx;
  border-left: 8rpx solid var(--color-accent-red);
  color: #333333;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1;
}

.profile-entry-list {
  display: grid;
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 40rpx;
}

.profile-entry {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  box-sizing: border-box;
  width: auto;
  max-width: 100%;
  min-width: 0;
  min-height: 112rpx;
  margin: 0;
  padding: 0 4rpx;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: #666666;
  line-height: normal;
  text-align: center;
  flex-direction: column;
  gap: 14rpx;
  justify-self: stretch;
}

.profile-entry::after {
  display: none;
}

.profile-entry--pressed {
  opacity: 0.7;
}

.profile-entry__icon-shell,
.profile-entry__icon-shell--1,
.profile-entry__icon-shell--2,
.profile-entry__icon-shell--3,
.profile-entry__icon-shell--legal {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  flex: 0 0 58rpx;
  border-radius: 0;
  background: transparent;
}

.profile-entry__icon {
  display: block;
  width: 56rpx;
  height: 56rpx;
}

.profile-entry__copy {
  min-width: 0;
  width: 100%;
}

.profile-entry__label {
  display: block;
  overflow: hidden;
  color: #666666;
  font-size: 29rpx;
  font-weight: 400;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-entry__description,
.profile-entry__arrow {
  display: none;
}

@keyframes profile-pulse {
  50% {
    opacity: 0.35;
    transform: scale(0.8);
  }
}

@media (prefers-reduced-motion: reduce) {
  .profile-identity__action {
    animation: none;
    transition: none;
  }
}
