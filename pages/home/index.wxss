page {
  background: var(--color-bg-page);
}

.home-page {
  min-height: 100vh;
  padding-bottom: calc(168rpx + env(safe-area-inset-bottom));
  overflow-x: hidden;
  background: var(--color-bg-page);
  color: var(--color-text-heading);
}

.hero {
  position: relative;
  height: 1065rpx;
  overflow: hidden;
  background: #f4f3ef;
}

.hero__backgrounds,
.hero__swiper,
.hero__slide,
.hero__text-image,
.hero__fallback {
  width: 100%;
  height: 100%;
}

.hero__backgrounds {
  position: absolute;
  z-index: 0;
  inset: 0;
  background:
    radial-gradient(circle at 76% 20%, rgba(167, 200, 192, 0.3), transparent 30%),
    radial-gradient(circle at 24% 38%, rgba(217, 163, 154, 0.16), transparent 27%),
    linear-gradient(160deg, var(--color-bg-section) 0%, var(--color-bg-primary-soft) 100%);
}

.hero__background {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0;
  inset: 0;
  transition: opacity 700ms ease;
}

.hero__background--active {
  opacity: 1;
}

.hero__swiper {
  position: relative;
  z-index: 2;
}

.hero__slide {
  position: relative;
  overflow: hidden;
}

.hero__text-image {
  position: absolute;
  width: 100%;
  height: 100%;
  inset: 0;
  pointer-events: none;
}

.hero__fallback {
  position: relative;
  background:
    radial-gradient(circle at 75% 18%, rgba(170, 207, 199, 0.48), transparent 28%),
    linear-gradient(160deg, var(--color-bg-section) 0%, var(--color-bg-primary-soft) 100%);
}

.home-brand {
  position: absolute;
  z-index: 20;
  left: 30rpx;
  width: 260rpx;
  transform: translateY(-14rpx);
  pointer-events: none;
}

.home-brand__image {
  display: block;
  width: 100%;
}

.home-search {
  position: absolute;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(78, 91, 87, 0.12);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
}

.home-search__glass {
  width: 15rpx;
  height: 15rpx;
  border: 2rpx solid #53615e;
  border-radius: 50%;
}

.home-search__handle {
  width: 8rpx;
  height: 2rpx;
  margin-top: 13rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: #53615e;
  transform: rotate(45deg);
  transform-origin: left center;
}

.hero-tools {
  position: absolute;
  z-index: 12;
  top: 220rpx;
  right: 30rpx;
  display: flex;
  width: 62rpx;
  align-items: center;
  flex-direction: column;
  gap: 12rpx;
}

.hero-tool {
  display: flex;
  width: 62rpx;
  min-width: 62rpx;
  max-width: 62rpx;
  height: 62rpx;
  min-height: 62rpx;
  max-height: 62rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 0 0 12rpx;
  border: 1rpx solid rgba(89, 113, 107, 0.15);
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  box-shadow: 0 7rpx 20rpx rgba(56, 76, 71, 0.08);
  box-sizing: border-box;
  flex: 0 0 62rpx;
  -webkit-backdrop-filter: blur(12rpx);
  backdrop-filter: blur(12rpx);
  line-height: 1;
  transition: transform 100ms ease, background-color 120ms ease;
}

.hero-tool--pressed {
  background: rgba(241, 246, 243, 0.88);
  transform: scale(0.94);
}

.hero-tool--active {
  border-color: rgba(94, 133, 124, 0.26);
  background: rgba(224, 237, 232, 0.84);
}

.music-note {
  position: relative;
  width: 27rpx;
  height: 28rpx;
}

.music-note__beam,
.music-note__stem {
  position: absolute;
  border-radius: 2rpx;
  background: var(--color-primary);
}

.music-note__beam {
  top: 2rpx;
  left: 8rpx;
  width: 18rpx;
  height: 4rpx;
  transform: rotate(-8deg);
  transform-origin: right center;
}

.music-note__stem {
  top: 3rpx;
  width: 3rpx;
  height: 18rpx;
}

.music-note__stem--left { left: 8rpx; }
.music-note__stem--right { right: 1rpx; }

.music-note__dot {
  position: absolute;
  bottom: 1rpx;
  width: 9rpx;
  height: 7rpx;
  border-radius: 52% 48% 54% 46%;
  background: var(--color-primary);
  transform: rotate(-16deg);
}

.music-note__dot--left { left: 0; }
.music-note__dot--right { right: 0; }

.music-equalizer {
  display: flex;
  height: 27rpx;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
}

.music-equalizer__bar {
  width: 4rpx;
  border-radius: 3rpx;
  background: var(--color-primary);
  transform-origin: center bottom;
  animation: home-music-pulse 760ms ease-in-out infinite alternate;
}

.music-equalizer__bar--1 { height: 16rpx; animation-delay: -220ms; }
.music-equalizer__bar--2 { height: 26rpx; animation-delay: -470ms; }
.music-equalizer__bar--3 { height: 20rpx; animation-delay: -90ms; }

@keyframes home-music-pulse {
  from { transform: scaleY(0.42); opacity: 0.64; }
  to { transform: scaleY(1); opacity: 1; }
}

.hero__story {
  position: absolute;
  z-index: 4;
  right: 30rpx;
  bottom: 112rpx;
  left: 30rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  text-align: center;
  pointer-events: none;
}

.hero__description {
  display: block;
}

.hero__description {
  max-width: 560rpx;
  margin-top: 0;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.5;
}

.hero__retry {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 70rpx;
  margin-top: 22rpx;
  border-radius: 35rpx;
  background: #728e88;
  color: var(--color-white);
  font-size: 24rpx;
  font-weight: 700;
  pointer-events: auto;
}

.home-hub {
  position: relative;
  z-index: 4;
  margin-top: -50rpx;
  padding: 34rpx 30rpx 18rpx;
  border-radius: 48rpx 48rpx 0 0;
  background: var(--color-bg-section);
}

.home-hub-identity {
  display: flex;
  width: auto;
  min-width: 0;
  min-height: 112rpx;
  align-items: center;
  margin: 0 0 30rpx;
  padding: 0;
  text-align: left;
  transition: opacity 100ms ease, transform 100ms ease;
}

.home-hub-identity--pressed {
  opacity: 0.8;
  transform: scale(0.99);
}

.home-hub-identity__avatar-shell {
  width: 96rpx;
  height: 96rpx;
  overflow: hidden;
  flex: 0 0 96rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 50%;
  background: #eeeee7;
  box-shadow: 0 8rpx 22rpx var(--color-shadow);
}

.home-hub-identity__avatar {
  display: block;
  width: 100%;
  height: 100%;
}

.home-hub-identity__copy {
  min-width: 0;
  margin-left: 20rpx;
  flex: 1;
}

.home-hub-identity__name,
.home-hub-identity__description,
.home-hub-identity__works-count,
.home-hub-identity__works-label {
  display: block;
}

.home-hub-identity__name {
  overflow: hidden;
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-hub-identity__description {
  display: inline-block;
  max-width: 100%;
  margin-top: 7rpx;
  padding: 3rpx 11rpx;
  border: 1rpx solid #f0aa58;
  border-radius: 18rpx;
  background: #fff0d1;
  color: #ff6159;
  font-size: 19rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-hub-identity__works {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  margin-left: 16rpx;
  flex: 0 0 100rpx;
  flex-direction: column;
  text-align: center;
  transition: opacity 100ms ease, transform 100ms ease;
}

.home-hub-identity__works--pressed {
  opacity: 0.7;
  transform: scale(0.96);
}

.home-hub-identity__works-count {
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1;
}

.home-hub-identity__works-label {
  margin-top: 7rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.home-hub__features {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  align-items: flex-start;
  column-gap: 30rpx;
}

.home-hub-card {
  display: block;
  width: calc((100% - 30rpx) / 2);
  max-width: calc((100% - 30rpx) / 2);
  min-width: 0;
  flex: 0 0 calc((100% - 30rpx) / 2);
  margin: 0;
  padding: 0;
  overflow: visible;
  box-sizing: border-box;
  border: 0;
  border-radius: 0;
  background: transparent;
  text-align: center;
  transform-origin: center;
  transition: opacity 100ms ease, transform 110ms ease;
}

.home-hub-card--pressed {
  opacity: 0.86;
  transform: scale(0.985);
}

.home-hub-card__media {
  position: relative;
  height: 286rpx;
  overflow: hidden;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 20rpx;
  background: var(--color-bg-media);
}

.home-hub-card__image,
.home-hub-card__veil {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.home-hub-card__image--fallback {
  background:
    radial-gradient(circle at 74% 34%, rgba(167, 200, 192, 0.38), transparent 22%),
    radial-gradient(circle at 34% 72%, rgba(217, 163, 154, 0.2), transparent 25%),
    linear-gradient(145deg, #f5f3ed, #e5ebe6);
}

.home-hub-card__veil {
  background: linear-gradient(180deg, transparent 62%, rgba(64, 76, 72, 0.08) 100%);
  pointer-events: none;
}

.home-hub-card__body {
  padding: 15rpx 2rpx 0;
}

.home-hub-card__title-row {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: center;
}

.home-hub-card__title,
.home-hub-card__description {
  display: block;
}

.home-hub-card__title {
  width: 100%;
  min-width: 0;
  overflow: hidden;
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 39rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-hub-card__description {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 22rpx;
  line-height: 1.5;
  text-align: center;
}

.home-hub__shortcuts {
  display: flex;
  margin-top: 34rpx;
  padding-top: 28rpx;
  border-top: 1rpx solid var(--color-divider);
}

.home-hub-shortcut {
  display: flex;
  width: 25%;
  min-width: 0;
  min-height: 138rpx;
  align-items: center;
  justify-content: flex-start;
  margin: 0;
  padding: 0 6rpx;
  flex: 0 0 25%;
  flex-direction: column;
  border-radius: 12rpx;
  background: transparent;
  transition: background-color 100ms ease, transform 100ms ease;
}

.home-hub-shortcut--pressed {
  background: rgba(231, 238, 234, 0.58);
  transform: scale(0.97);
}

.home-hub-shortcut__media {
  width: 104rpx;
  height: 104rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 28rpx;
  background: var(--color-bg-media);
  box-shadow: 0 7rpx 18rpx var(--color-shadow-soft);
}

.home-hub-shortcut__image {
  display: block;
  width: 100%;
  height: 100%;
}

.home-hub-shortcut__image--fallback {
  background:
    radial-gradient(circle at 65% 32%, rgba(255, 255, 255, 0.9), transparent 22%),
    linear-gradient(145deg, #f2f2ec, #dfe8e2);
}

.home-hub-shortcut__label {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  overflow: hidden;
  color: #596762;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-enter {
  animation: home-rise 480ms cubic-bezier(0.22, 0.76, 0.22, 1) both;
}

.home-hub.home-enter { animation-delay: 70ms; }

@keyframes home-rise {
  from { opacity: 0; transform: translateY(14rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .home-enter,
  .music-equalizer__bar {
    animation: none;
  }

  .hero__background,
  .home-hub-identity,
  .home-hub-card,
  .home-hub-shortcut {
    transition: none;
  }
}

.home-hub-identity__works-count {
  font-family: var(--font-number);
}
