<theme-provider>
<view class="home-page">
  <view class="hero" aria-label="首页轮播海报">
    <block wx:if="{{heroSlides.length > 0}}">
      <view class="hero__backgrounds" aria-hidden="true">
        <image
          wx:for="{{heroSlides}}"
          wx:key="id"
          class="hero__background {{index === currentSlide ? 'hero__background--active' : ''}}"
          src="{{item.imageUrl}}"
          mode="aspectFill"
          data-slide-id="{{item.id}}"
          data-image-url="{{item.imageUrl}}"
          binderror="handleHeroBackgroundError"
        />
      </view>
      <swiper
        class="hero__swiper"
        autoplay="{{heroAutoplayEnabled && heroSlides.length > 1}}"
        circular="{{heroSlides.length > 1}}"
        duration="700"
        interval="5200"
        bindchange="handleSlideChange"
      >
        <swiper-item wx:for="{{heroSlides}}" wx:key="id">
          <view
            class="hero__slide"
            data-route="{{item.route}}"
            bindtap="handleHeroSlideTap"
            role="{{item.route ? 'button' : 'img'}}"
            aria-label="{{item.route ? '打开轮播内容' : '轮播文字说明'}}"
          >
            <image
              wx:if="{{item.textImageUrl}}"
              class="hero__text-image"
              src="{{item.textImageUrl}}"
              mode="aspectFill"
              data-slide-id="{{item.id}}"
              data-image-url="{{item.textImageUrl}}"
              binderror="handleHeroTextImageError"
            />
          </view>
        </swiper-item>
      </swiper>
    </block>

    <view wx:else class="hero__fallback">
      <view class="hero__story">
        <text wx:if="{{homeConfigStatus === 'loading'}}" class="hero__description">正在加载首页内容…</text>
        <text wx:elif="{{homeConfigStatus === 'empty'}}" class="hero__description">后台暂未配置首页轮播</text>
        <text wx:else class="hero__description">{{homeConfigErrorMessage || '首页配置暂时无法加载'}}</text>
        <button
          wx:if="{{homeConfigStatus === 'error'}}"
          class="hero__retry"
          bindtap="handleRetrySettings"
        >重新加载</button>
      </view>
    </view>

    <view wx:if="{{horizontalLogoImageUrl}}" class="home-brand" style="top: {{menuButtonTopPx}}px;">
      <image
        class="home-brand__image"
        src="{{horizontalLogoImageUrl}}"
        mode="widthFix"
        binderror="handleHorizontalLogoError"
      />
    </view>

    <view wx:if="{{heroSlides.length > 0 && hasHomeMusic}}" class="hero-tools">
      <view
        class="hero-tool {{isHomeMusicPlaying ? 'hero-tool--active' : ''}}"
        bindtap="handleToggleHomeMusic"
        hover-class="hero-tool--pressed"
        hover-stay-time="80"
        role="button"
        aria-label="{{isHomeMusicPlaying ? '暂停背景音乐' : '播放背景音乐'}}"
      >
        <view wx:if="{{isHomeMusicPlaying}}" class="music-equalizer" aria-hidden="true">
          <view class="music-equalizer__bar music-equalizer__bar--1"></view>
          <view class="music-equalizer__bar music-equalizer__bar--2"></view>
          <view class="music-equalizer__bar music-equalizer__bar--3"></view>
        </view>
        <view wx:else class="music-note" aria-hidden="true">
          <view class="music-note__beam"></view>
          <view class="music-note__stem music-note__stem--left"></view>
          <view class="music-note__stem music-note__stem--right"></view>
          <view class="music-note__dot music-note__dot--left"></view>
          <view class="music-note__dot music-note__dot--right"></view>
        </view>
      </view>
    </view>
  </view>

  <view class="home-hub home-enter">
    <view
      class="home-hub-identity"
      bindtap="handleOpenProfile"
      hover-class="home-hub-identity--pressed"
      hover-stay-time="100"
      role="button"
      aria-label="进入我的页面"
    >
      <view class="home-hub-identity__avatar-shell">
        <image
          class="home-hub-identity__avatar"
          src="{{homeIdentityAvatarUrl}}"
          mode="aspectFill"
          binderror="handleHomeIdentityAvatarError"
        />
      </view>
      <view class="home-hub-identity__copy">
        <text class="home-hub-identity__name">{{homeIdentityName}}</text>
        <text class="home-hub-identity__description">{{homeIdentityDescription}}</text>
      </view>
      <view
        class="home-hub-identity__works"
        data-url="/pages/profile/my-designs/index"
        data-login-copy="登录后可查看已保存的作品。"
        catchtap="handleProtectedEntry"
        hover-class="home-hub-identity__works--pressed"
        hover-stay-time="100"
        role="button"
        aria-label="我的作品 {{homeIdentityWorkCount}} 件，点击查看"
      >
        <text class="home-hub-identity__works-count">{{homeIdentityWorkCount}}</text>
        <text class="home-hub-identity__works-label">我的作品</text>
      </view>
    </view>

    <view class="home-hub__features">
      <button
        class="home-hub-card"
        bindtap="handleStartDiy"
        hover-class="home-hub-card--pressed"
        hover-stay-time="100"
        aria-label="AI 搭配，进入 DIY 页面"
      >
        <view class="home-hub-card__media">
          <image
            wx:if="{{mainHandcraftImageUrl}}"
            class="home-hub-card__image"
            src="{{mainHandcraftImageUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-asset="mainHandcraftImageUrl"
            binderror="handleHomeAssetError"
          />
          <view wx:else class="home-hub-card__image home-hub-card__image--fallback"></view>
          <view class="home-hub-card__veil"></view>
        </view>
        <view class="home-hub-card__body">
          <view class="home-hub-card__title-row">
            <text class="home-hub-card__title">AI 搭配</text>
          </view>
          <text class="home-hub-card__description">智能选珠，生成专属手串</text>
        </view>
      </button>

      <button
        class="home-hub-card"
        bindtap="handleViewAllDesigns"
        hover-class="home-hub-card--pressed"
        hover-stay-time="100"
        aria-label="AI 试戴，进入灵感页"
      >
        <view class="home-hub-card__media">
          <image
            wx:if="{{mainFinishedStyleImageUrl}}"
            class="home-hub-card__image"
            src="{{mainFinishedStyleImageUrl}}"
            mode="aspectFill"
            lazy-load="{{true}}"
            data-asset="mainFinishedStyleImageUrl"
            binderror="handleHomeAssetError"
          />
          <view wx:else class="home-hub-card__image home-hub-card__image--fallback"></view>
          <view class="home-hub-card__veil"></view>
        </view>
        <view class="home-hub-card__body">
          <view class="home-hub-card__title-row">
            <text class="home-hub-card__title">AI 试戴</text>
          </view>
          <text class="home-hub-card__description">智能预览，找到适合你的款式</text>
        </view>
      </button>
    </view>

    <view class="home-hub__shortcuts">
      <button
        class="home-hub-shortcut"
        bindtap="handleViewAllDesigns"
        hover-class="home-hub-shortcut--pressed"
      >
        <view class="home-hub-shortcut__media">
          <image wx:if="{{shortcutInspirationImageUrl}}" class="home-hub-shortcut__image" src="{{shortcutInspirationImageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-asset="shortcutInspirationImageUrl" binderror="handleHomeAssetError" />
          <view wx:else class="home-hub-shortcut__image home-hub-shortcut__image--fallback"></view>
        </view>
        <text class="home-hub-shortcut__label">灵感图鉴</text>
      </button>

      <button
        class="home-hub-shortcut"
        bindtap="handleOpenCart"
        hover-class="home-hub-shortcut--pressed"
      >
        <view class="home-hub-shortcut__media">
          <image wx:if="{{shortcutCartImageUrl}}" class="home-hub-shortcut__image" src="{{shortcutCartImageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-asset="shortcutCartImageUrl" binderror="handleHomeAssetError" />
          <view wx:else class="home-hub-shortcut__image home-hub-shortcut__image--fallback"></view>
        </view>
        <text class="home-hub-shortcut__label">购物车</text>
      </button>

      <button
        class="home-hub-shortcut"
        data-url="/pages/profile/orders/index"
        data-login-copy="登录后可查看订单进度。"
        bindtap="handleProtectedEntry"
        hover-class="home-hub-shortcut--pressed"
      >
        <view class="home-hub-shortcut__media">
          <image wx:if="{{shortcutOrdersImageUrl}}" class="home-hub-shortcut__image" src="{{shortcutOrdersImageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-asset="shortcutOrdersImageUrl" binderror="handleHomeAssetError" />
          <view wx:else class="home-hub-shortcut__image home-hub-shortcut__image--fallback"></view>
        </view>
        <text class="home-hub-shortcut__label">我的订单</text>
      </button>

      <button
        class="home-hub-shortcut"
        data-url="/pages/profile/my-designs/index"
        data-login-copy="登录后可查看已保存的设计。"
        bindtap="handleProtectedEntry"
        hover-class="home-hub-shortcut--pressed"
      >
        <view class="home-hub-shortcut__media">
          <image wx:if="{{shortcutDesignsImageUrl}}" class="home-hub-shortcut__image" src="{{shortcutDesignsImageUrl}}" mode="aspectFill" lazy-load="{{true}}" data-asset="shortcutDesignsImageUrl" binderror="handleHomeAssetError" />
          <view wx:else class="home-hub-shortcut__image home-hub-shortcut__image--fallback"></view>
        </view>
        <text class="home-hub-shortcut__label">我的设计</text>
      </button>
    </view>
  </view>

  <customer-service-float />
  <phone-login-modal id="phone-login-modal" />

</view>
</theme-provider>
