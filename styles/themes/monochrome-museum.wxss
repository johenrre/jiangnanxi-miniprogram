/* 黑白博物馆风 */
.theme-root.theme-monochrome-museum {
  --color-bg-page: #ececea;
  --color-bg-surface: #fafaf7;
  --color-bg-section: #f3f3f0;
  --color-bg-warm: #f5f2ed;
  --color-bg-muted: #dedfdd;
  --color-bg-media: #d5d7d6;
  --color-bg-primary-soft: #e2e5e4;
  --color-text-heading: #272a2b;
  --color-text-primary: #373b3c;
  --color-text-secondary: #696f71;
  --color-text-muted: #808687;
  --color-text-faint: #979c9d;
  --color-primary: #4f5759;
  --color-primary-light: #697173;
  --color-primary-muted: #858d8e;
  --color-primary-pressed: #3d4446;
  --color-accent-jade: #9aa6a3;
  --color-accent-blush: #9b7b72;
  --color-accent-blush-strong: #806259;
  --color-white: #ffffff;
  --color-divider: rgba(55, 59, 60, 0.08);
  --color-border-hairline: rgba(55, 59, 60, 0.10);
  --color-border-soft: rgba(79, 87, 89, 0.09);
  --color-border: rgba(79, 87, 89, 0.15);
  --color-border-strong: rgba(79, 87, 89, 0.24);
  --color-shadow-soft: rgba(39, 42, 43, 0.07);
  --color-shadow: rgba(39, 42, 43, 0.11);
  --color-shadow-primary: rgba(61, 68, 70, 0.16);
  --color-modal-backdrop: rgba(28, 30, 31, 0.50);
  --color-modal-shadow: rgba(39, 42, 43, 0.20);
  --color-surface-glass: rgba(250, 250, 247, 0.84);
  --color-surface-glass-strong: rgba(250, 250, 247, 0.97);
  --color-nav-surface: rgba(247, 247, 244, 0.97);
  --color-nav-indicator: #5f6769;
  --color-nav-ring: rgba(243, 243, 240, 0.98);
  --color-nav-shadow: rgba(39, 42, 43, 0.13);
  --color-nav-shadow-soft: rgba(39, 42, 43, 0.04);
}
