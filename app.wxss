@import "./styles/theme.wxss";

page {
  min-height: 100%;
  background: var(--color-bg-page);
  color: var(--color-text-primary);
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 24rpx;
  -webkit-font-smoothing: antialiased;
}

button,
image,
input,
picker,
scroll-view,
swiper,
swiper-item,
text,
textarea,
view {
  box-sizing: border-box;
}

image {
  display: block;
}

button {
  margin: 0;
  padding: 0;
  background: transparent;
  color: inherit;
  line-height: 1;
}

button::after {
  border: 0;
}

button[disabled] {
  opacity: 0.56;
}

.placeholder-page {
  min-height: 100vh;
  padding: 104rpx 40rpx 180rpx;
  background: var(--color-bg-page);
}

.placeholder-page__eyebrow {
  color: var(--color-text-secondary);
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.placeholder-page__title {
  display: block;
  margin-top: 14rpx;
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 46rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  line-height: 1.3;
}

.placeholder-page__description {
  display: block;
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
  line-height: 1.75;
}

.placeholder-page__panel {
  min-height: 280rpx;
  margin-top: 50rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 28rpx;
  background: var(--color-surface-glass);
}
