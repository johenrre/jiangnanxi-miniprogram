:host {
  display: block;
}

.customer-float {
  position: fixed;
  z-index: 850;
  right: 20rpx;
  bottom: calc(154rpx + env(safe-area-inset-bottom));
  display: flex;
  width: 140rpx;
  height: 140rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  overflow: visible;
  background: transparent;
  transform: translate3d(0, 0, 0);
  transition: opacity 110ms ease, transform 110ms ease;
}

.customer-float--pressed {
  opacity: 0.84;
  transform: translate3d(0, 2rpx, 0) scale(0.97);
}

.customer-float--draggable {
  bottom: auto;
  touch-action: none;
  will-change: top, transform;
}

.customer-float__image {
  display: block;
  width: 140rpx;
  height: 140rpx;
  filter: drop-shadow(0 5rpx 9rpx rgba(63, 78, 73, 0.18));
}

.customer-modal-layer {
  position: fixed;
  z-index: 12000;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
}

.customer-modal-layer__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(39, 46, 44, 0.44);
  -webkit-backdrop-filter: blur(8rpx);
  backdrop-filter: blur(8rpx);
}

.customer-modal {
  position: relative;
  z-index: 1;
  display: flex;
  width: 650rpx;
  max-width: 100%;
  align-items: center;
  padding: 44rpx 38rpx 40rpx;
  border: 1rpx solid rgba(90, 113, 107, 0.12);
  border-radius: 30rpx;
  background: #f9f8f4;
  box-shadow: 0 28rpx 80rpx rgba(48, 58, 55, 0.21);
  box-sizing: border-box;
  flex-direction: column;
}

.customer-modal__close {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  width: 54rpx;
  min-width: 54rpx;
  max-width: 54rpx;
  height: 54rpx;
  min-height: 54rpx;
  max-height: 54rpx;
  align-items: center;
  justify-content: center;
  padding: 0 0 4rpx;
  border: 1rpx solid rgba(90, 113, 107, 0.12);
  border-radius: 50%;
  background: var(--color-bg-muted);
  color: #7b8985;
  font-family: var(--font-body);
  font-size: 32rpx;
  font-weight: 300;
  line-height: 1;
  transition: background-color 100ms ease, transform 100ms ease;
}

.customer-modal__close--pressed {
  background: var(--color-bg-media);
  transform: scale(0.94);
}

.customer-modal__eyebrow,
.customer-modal__title,
.customer-modal__tip {
  display: block;
}

.customer-modal__eyebrow {
  color: #b27f76;
  font-size: 12rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.customer-modal__title {
  margin-top: 11rpx;
  color: #43514d;
  font-family: var(--font-body);
  font-size: 39rpx;
  font-weight: 500;
  letter-spacing: 3rpx;
  line-height: 1.3;
}

.customer-modal__tip {
  margin-top: 12rpx;
  color: #7e8b87;
  font-size: 21rpx;
  line-height: 1.5;
  text-align: center;
}

.customer-modal__qr-shell {
  display: flex;
  width: 510rpx;
  height: 510rpx;
  align-items: center;
  justify-content: center;
  margin-top: 26rpx;
  padding: 16rpx;
  border: 1rpx solid rgba(90, 113, 107, 0.1);
  border-radius: 22rpx;
  background: var(--color-white);
  box-shadow: 0 10rpx 30rpx rgba(66, 85, 80, 0.055);
  box-sizing: border-box;
}

.customer-modal__qr {
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 10rpx;
}

.customer-modal__empty {
  display: flex;
  align-items: center;
  color: #99a29f;
  font-size: 20rpx;
  flex-direction: column;
  gap: 22rpx;
}

.customer-modal__empty-mark {
  display: flex;
  width: 74rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #9fb2ad;
  border-radius: 18rpx;
  gap: 6rpx;
}

.customer-modal__empty-mark view {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: #90aaa4;
}

@media (prefers-reduced-motion: reduce) {
  .customer-float,
  .customer-modal__close {
    transition: none;
  }
}
