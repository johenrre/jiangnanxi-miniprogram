.design-card {
  min-width: 0;
  overflow: hidden;
  background: var(--color-bg-surface);
  transition: transform 120ms ease;
}

.design-card--pressed {
  transform: scale(0.985);
}

.design-card--home {
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform-origin: center center;
}

.design-card--discover {
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.design-card__media {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #dbe8e5, #eef5f2);
}

.design-card--home .design-card__media {
  height: 330rpx;
  border: 1rpx solid rgba(90, 111, 105, 0.09);
  border-radius: 20rpx;
  background: var(--color-bg-media);
  box-shadow: 0 12rpx 28rpx rgba(76, 93, 88, 0.07);
}

.design-card--discover .design-card__media {
  height: 326rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 20rpx;
  background: var(--color-bg-media);
  box-shadow: 0 10rpx 24rpx var(--color-shadow-soft);
}

.design-card__cover,
.design-card__cover-fallback {
  width: 100%;
  height: 100%;
}

.design-card__tray {
  position: absolute;
  z-index: 0;
  top: 50%;
  left: 50%;
  width: 84%;
  height: 84%;
  opacity: 1;
  transform: translate(-50%, -50%);
}

.design-card--home .design-card__tray {
  width: 84%;
  height: 84%;
  opacity: 1;
}

.design-card--discover .design-card__tray {
  width: 86%;
  height: 86%;
  opacity: 1;
}

.design-card__bracelet {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.design-card__pinned {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  right: 14rpx;
  height: 38rpx;
  padding: 0 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.42);
  border-radius: 999rpx;
  background: rgba(31, 58, 54, 0.88);
  box-shadow: 0 4rpx 12rpx rgba(20, 42, 39, 0.14);
  color: #ffffff;
  font-size: 18rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 38rpx;
}

.design-card__cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--color-primary-light);
  font-size: 20rpx;
  gap: 14rpx;
}

.design-card__fallback-ring {
  width: 116rpx;
  height: 116rpx;
  border: 18rpx solid rgba(49, 93, 90, 0.14);
  border-radius: 50%;
}

.design-card--home .design-card__body {
  padding: 15rpx 4rpx 0;
}

.design-card--discover .design-card__body {
  padding: 15rpx 4rpx 0;
}

.design-card__heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-width: 0;
  gap: 10rpx;
}

.design-card__name {
  min-width: 0;
  overflow: hidden;
  color: #172f2d;
  font-size: 25rpx;
  font-weight: 800;
  line-height: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-card__price {
  color: var(--color-accent-blush-strong);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 30rpx;
  white-space: nowrap;
}

.design-card--home .design-card__heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
}

.design-card--discover .design-card__heading {
  display: flex;
  align-items: baseline;
}

.design-card--home .design-card__price {
  display: block;
  margin-top: 0;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.design-card--discover .design-card__price {
  display: block;
  margin-top: 0;
  padding: 0;
  background: transparent;
  color: var(--color-primary);
  font-size: 20rpx;
  font-weight: 700;
}

.design-card__author {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-top: 12rpx;
  gap: 10rpx;
}

.design-card--home .design-card__author {
  min-height: 32rpx;
  margin-top: 9rpx;
  gap: 8rpx;
}

.design-card--discover .design-card__author {
  justify-content: flex-start;
  min-height: 32rpx;
  margin-top: 9rpx;
  padding: 0;
  background: transparent;
}

.design-card__avatar {
  display: block;
  width: 34rpx;
  height: 34rpx;
  overflow: hidden;
  border-radius: 50%;
  background: #d9e5e2;
}

.design-card--home .design-card__avatar {
  width: 30rpx;
  height: 30rpx;
  background: #e1e9e5;
}

.design-card__author-name {
  min-width: 0;
  overflow: hidden;
  color: #6a7d79;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 28rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-card--home .design-card__name {
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 25rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.design-card--home .design-card__author-name {
  color: var(--color-text-secondary);
  font-size: 17rpx;
  font-weight: 500;
}

.design-card__open {
  margin-left: auto;
  color: var(--color-primary-light);
  font-size: 20rpx;
  line-height: 1;
}

.design-card--discover .design-card__author-name {
  color: var(--color-text-secondary);
  font-size: 18rpx;
  font-weight: 500;
  text-align: left;
}

.design-card--discover .design-card__name {
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 25rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.design-card--discover .design-card__avatar {
  width: 30rpx;
  height: 30rpx;
  background: #e1e9e5;
}

@media (prefers-reduced-motion: reduce) {
  .design-card {
    transition: none;
  }
}

.design-card__price {
  font-family: var(--font-number);
}
