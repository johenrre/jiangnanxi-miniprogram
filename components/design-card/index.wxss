.design-card {
  min-width: 0;
  overflow: hidden;
  background: var(--color-bg-surface);
  transition: transform 120ms ease;
}

.design-card--pressed {
  transform: scale(0.985);
}

.design-card--home {
  overflow: visible;
  border: 0;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  transform-origin: center center;
}

.design-card--discover {
  overflow: hidden;
  border: 0;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.025);
}

.design-card__media {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #dbe8e5, #eef5f2);
}

.design-card--home .design-card__media {
  height: 330rpx;
  border: 1rpx solid rgba(90, 111, 105, 0.09);
  border-radius: 20rpx;
  background: var(--color-bg-media);
  box-shadow: 0 12rpx 28rpx rgba(76, 93, 88, 0.07);
}

.design-card--discover .design-card__media {
  height: 326rpx;
  border: 0;
  border-radius: 0;
  background: #f9f9f9;
  box-shadow: none;
}

.design-card__cover,
.design-card__cover-fallback {
  width: 100%;
  height: 100%;
}

.design-card__tray {
  position: absolute;
  z-index: 0;
  top: 50%;
  left: 50%;
  width: 84%;
  height: 84%;
  opacity: 1;
  transform: translate(-50%, -50%);
}

.design-card--home .design-card__tray {
  width: 84%;
  height: 84%;
  opacity: 1;
}

.design-card--discover .design-card__tray {
  width: 86%;
  height: 86%;
  opacity: 1;
}

.design-card__bracelet {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.design-card__pinned {
  position: absolute;
  z-index: 2;
  top: 14rpx;
  left: 14rpx;
  padding: 6rpx 14rpx;
  border: 0;
  border-radius: 999rpx;
  background: rgba(18, 18, 18, 0.72);
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.design-card__cover-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: var(--color-primary-light);
  font-size: 20rpx;
  gap: 14rpx;
}

.design-card__fallback-ring {
  width: 116rpx;
  height: 116rpx;
  border: 18rpx solid rgba(49, 93, 90, 0.14);
  border-radius: 50%;
}

.design-card--home .design-card__body {
  padding: 15rpx 4rpx 0;
}

.design-card--discover .design-card__body {
  padding: 20rpx;
  background: #ffffff;
}

.design-card__name {
  display: -webkit-box;
  min-width: 0;
  overflow: hidden;
  color: #333333;
  font-family: var(--font-body);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.4;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.design-card__footer {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  gap: 8rpx;
}

.design-card__author {
  display: flex;
  min-width: 0;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.design-card__price {
  flex: 0 0 auto;
  color: #9a7b4f;
  font-family: var(--font-number);
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1;
  white-space: nowrap;
}

.design-card__avatar {
  display: block;
  width: 36rpx;
  height: 36rpx;
  overflow: hidden;
  margin-right: 12rpx;
  flex: 0 0 36rpx;
  border: 1rpx solid #f0f0f0;
  border-radius: 50%;
  background: #eeeeee;
}

.design-card__author-name {
  min-width: 0;
  max-width: 120rpx;
  overflow: hidden;
  color: #909399;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 36rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.design-card--home .design-card__name {
  color: #333333;
}

.design-card--home .design-card__author-name {
  color: #909399;
}

@media (prefers-reduced-motion: reduce) {
  .design-card {
    transition: none;
  }
}
