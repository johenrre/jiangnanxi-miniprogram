.content-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 430rpx;
  padding: 76rpx 54rpx;
  flex-direction: column;
  color: var(--color-text-primary);
  text-align: center;
}

.content-state__mark,
.content-state__spinner {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid rgba(96, 125, 118, 0.16);
  border-radius: 50%;
  background: rgba(231, 238, 234, 0.72);
}

.content-state__mark-ring {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(96, 125, 118, 0.34);
  border-radius: 50%;
}

.content-state__mark-core {
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-primary-muted);
}

.content-state__spinner {
  width: 62rpx;
  height: 62rpx;
  border: 5rpx solid var(--color-border);
  border-top-color: var(--color-primary-light);
  background: transparent;
  animation: content-state-spin 0.85s linear infinite;
}

.content-state--error .content-state__mark {
  border-color: rgba(183, 124, 114, 0.19);
  background: rgba(242, 226, 221, 0.7);
}

.content-state--error .content-state__mark-ring {
  border-color: rgba(183, 124, 114, 0.45);
}

.content-state--error .content-state__mark-core {
  background: var(--color-accent-blush);
}

.content-state__title,
.content-state__description {
  display: block;
}

.content-state__title {
  color: var(--color-text-primary);
  font-family: "Songti SC", "STSong", serif;
  font-size: 31rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.content-state__description {
  max-width: 540rpx;
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 22rpx;
  line-height: 1.7;
}

.content-state__action {
  min-width: 176rpx;
  height: 70rpx;
  margin-top: 30rpx;
  padding: 0 34rpx;
  border-radius: 18rpx;
  background: var(--color-primary);
  box-shadow: 0 10rpx 24rpx var(--color-shadow-primary);
  color: var(--color-white);
  font-size: 23rpx;
  font-weight: 600;
  line-height: 70rpx;
}

.content-state__action:active {
  background: var(--color-primary-pressed);
  transform: translateY(1rpx);
}

@keyframes content-state-spin {
  to { transform: rotate(360deg); }
}
