.content-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 430rpx;
  padding: 76rpx 54rpx;
  flex-direction: column;
  color: var(--color-text-primary);
  text-align: center;
}

.content-state__spinner,
.content-state__icon-shell {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 28rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 50%;
  background: var(--color-bg-muted);
}

.content-state__icon-shell {
  border: 0;
  border-radius: 24rpx;
  background: #fff6ed;
}

.content-state__icon {
  width: 48rpx;
  height: 48rpx;
}

.content-state__spinner {
  width: 62rpx;
  height: 62rpx;
  border: 5rpx solid var(--color-border);
  border-top-color: var(--color-primary-light);
  background: transparent;
  animation: content-state-spin 0.85s linear infinite;
}

.content-state__title,
.content-state__description {
  display: block;
}

.content-state__title {
  color: var(--color-text-primary);
  font-family: var(--font-body);
  font-size: 33rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.content-state__description {
  max-width: 540rpx;
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  line-height: 1.7;
}

.content-state__action {
  min-width: 176rpx;
  height: 70rpx;
  margin-top: 30rpx;
  padding: 0 34rpx;
  border-radius: 20rpx;
  background: var(--color-primary);
  box-shadow: 0 10rpx 24rpx var(--color-shadow-primary);
  color: var(--color-white);
  font-size: 27rpx;
  font-weight: 600;
  line-height: 70rpx;
}

.content-state__action:active {
  background: var(--color-primary-pressed);
  transform: translateY(1rpx);
}

@keyframes content-state-spin {
  to { transform: rotate(360deg); }
}
