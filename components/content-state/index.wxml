<view class="content-state content-state--{{status}}">
  <view wx:if="{{status === 'loading'}}" class="content-state__spinner"></view>
  <view wx:else class="content-state__icon-shell">
    <image class="content-state__icon" src="{{icon}}" mode="aspectFit" />
  </view>
  <text class="content-state__title">{{title}}</text>
  <text wx:if="{{description}}" class="content-state__description">{{description}}</text>
  <button wx:if="{{actionText}}" class="content-state__action" bindtap="handleAction">{{actionText}}</button>
</view>
