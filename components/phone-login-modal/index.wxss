.phone-login-mask {
  position: fixed;
  /* 必须高于自定义 Tab Bar（9000）和普通业务浮层。 */
  z-index: 20000;
  inset: 0;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(0, 0, 0, 0.56);
  animation: phone-login-mask-in 180ms ease-out both;
}

.phone-login-sheet {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 40rpx calc(34rpx + env(safe-area-inset-bottom));
  border-radius: 30rpx 30rpx 0 0;
  background: #ffffff;
  box-shadow: 0 -18rpx 52rpx rgba(0, 0, 0, 0.16);
  animation: phone-login-sheet-in 220ms ease-out both;
}

.phone-login-sheet__handle {
  width: 58rpx;
  height: 6rpx;
  margin: 0 auto 30rpx;
  border-radius: 4rpx;
  background: #dddddd;
}

.phone-login-sheet__title,
.phone-login-sheet__description {
  display: block;
}

.phone-login-sheet__title {
  margin-top: 0;
  color: #222222;
  font-family: var(--font-body);
  font-size: 38rpx;
  font-weight: 700;
  letter-spacing: 0;
  line-height: 1.3;
  text-align: left;
}

.phone-login-sheet__description {
  margin-top: 16rpx;
  color: #666666;
  font-size: 23rpx;
  line-height: 1.55;
  text-align: left;
}

.phone-login-sheet__agreement {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  margin-top: 26rpx;
  color: #999999;
  font-size: 20rpx;
  line-height: 1.6;
  flex-wrap: wrap;
}

.phone-login-sheet__agreement-check {
  display: inline-flex;
  align-items: center;
}

.phone-login-sheet__agreement-label {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
}

.phone-login-sheet__agreement-checkbox {
  margin-right: 6rpx;
  transform: scale(0.68);
  transform-origin: center;
}

.phone-login-sheet__agreement-link {
  min-height: 48rpx;
  color: #f6b400;
  font-weight: 600;
  line-height: 48rpx;
}

.phone-login-sheet__agreement-separator {
  min-height: 48rpx;
  color: #999999;
  line-height: 48rpx;
}

.phone-login-sheet__actions {
  display: flex;
  margin-top: 36rpx;
  gap: 20rpx;
}

.phone-login-sheet__button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  margin: 0;
  flex: 1;
  border-radius: 42rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.phone-login-sheet__button::after {
  border: 0;
}

.phone-login-sheet__button--secondary {
  border: 0;
  background: #f3f3f3;
  color: #777777;
}

.phone-login-sheet__button--primary {
  border: 2rpx solid #ffdf64;
  background: #ffe033;
  box-shadow: 0 16rpx 34rpx rgba(246, 180, 0, 0.36);
  color: #ffffff;
}

.phone-login-sheet__button--agreement-required {
  border-color: #f6b400;
  background: #ffffff;
  box-shadow: none;
  color: #f6b400;
  opacity: 1;
}

.phone-login-sheet__button[disabled] {
  opacity: 0.62;
}

@keyframes phone-login-mask-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes phone-login-sheet-in {
  from { transform: translateY(36rpx); }
  to { transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .phone-login-mask,
  .phone-login-sheet {
    animation: none;
  }
}
