:host {
  display: block;
  width: 100%;
}

.activity-popup {
  position: fixed;
  z-index: 12000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  box-sizing: border-box;
  width: 100vw;
  height: 100vh;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  padding: calc(88rpx + env(safe-area-inset-top)) 54rpx calc(36rpx + env(safe-area-inset-bottom));
  background: rgba(28, 34, 32, 0.64);
  animation: activity-popup-fade-in 180ms ease-out both;
}

.activity-popup__image {
  display: block;
  width: 640rpx;
  height: auto;
  overflow: hidden;
  flex: 0 0 auto;
  border-radius: 28rpx;
  box-shadow: 0 26rpx 72rpx rgba(12, 19, 17, 0.3);
}

.activity-popup__action::after,
.activity-popup__close::after {
  border: 0;
}

.activity-popup__action {
  position: relative;
  z-index: 2;
  display: flex;
  width: 336rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin: -44rpx 0 0;
  padding: 0 34rpx;
  flex: none;
  border-radius: 44rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 28rpx rgba(12, 19, 17, 0.2);
  color: #202522;
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  line-height: 1;
  transition: opacity 100ms ease, transform 100ms ease;
  white-space: nowrap;
}

.activity-popup__action--pressed {
  opacity: 0.9;
  transform: scale(0.97);
}

.activity-popup__close {
  position: relative;
  display: block;
  box-sizing: border-box;
  width: 82rpx;
  min-width: 82rpx;
  max-width: 82rpx;
  height: 82rpx;
  min-height: 82rpx;
  max-height: 82rpx;
  align-self: center;
  margin: 58rpx 0 0;
  padding: 0;
  flex: 0 0 82rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 50%;
  background: rgba(16, 20, 18, 0.16);
  line-height: 82rpx;
  transition: background-color 100ms ease, transform 100ms ease;
}

.activity-popup__close--pressed {
  background: rgba(255, 255, 255, 0.18);
  transform: scale(0.94);
}

.activity-popup__close-icon,
.activity-popup__close-icon::before,
.activity-popup__close-icon::after {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 30rpx;
  height: 3rpx;
  border-radius: 2rpx;
  background: #ffffff;
  content: "";
}

.activity-popup__close-icon {
  width: 0;
  height: 0;
  background: transparent;
}

.activity-popup__close-icon::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.activity-popup__close-icon::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

@keyframes activity-popup-fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .activity-popup {
    animation: none;
  }

  .activity-popup__action,
  .activity-popup__close {
    transition: none;
  }
}
