<view
  wx:if="{{imageUrl}}"
  class="activity-popup"
  bindtap="handleClose"
  catchtouchmove="handleTouchMove"
  role="dialog"
  aria-label="活动推荐"
>
  <image
    class="activity-popup__image"
    src="{{imageUrl}}"
    mode="widthFix"
    catchtap="handleOpen"
    binderror="handleImageError"
    aria-label="查看活动并进入灵感页"
  />
  <button
    class="activity-popup__action"
    catchtap="handleOpen"
    hover-class="activity-popup__action--pressed"
    hover-stay-time="100"
    aria-label="点击制作同款，进入灵感页"
  >
    点击制作同款
  </button>
  <button
    class="activity-popup__close"
    catchtap="handleClose"
    hover-class="activity-popup__close--pressed"
    hover-stay-time="100"
    aria-label="关闭活动弹窗"
  >
    <view class="activity-popup__close-icon" aria-hidden="true"></view>
  </button>
</view>
